<%- include('partials/head', { title: 'מקורבים', nav: true }) %>
<div class="pagehead">
  <h1>מקורבים (<%= contacts.length %>)</h1>
  <a class="btn" href="<%= base %>/contacts/new">+ הוספה</a>
</div>
<form class="search row-search" method="get">
  <input name="q" value="<%= term %>" placeholder="🔍 חיפוש לפי שם או טלפון…">
  <select name="cat" data-autosubmit>
    <option value="">כל הסיווגים</option>
    <% categories.forEach(c => { %><option value="<%= c.id %>" <%= cat === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
  </select>
  <select name="sort" data-autosubmit>
    <option value="">לפי שם</option>
    <option value="next" <%= sort === 'next' ? 'selected' : '' %>>לפי יום הולדת קרוב</option>
  </select>
</form>
<div class="card list">
  <% if (!contacts.length) { %><p class="muted"><%= term || cat ? 'לא נמצאו תוצאות.' : 'עדיין אין מקורבים.' %></p><% } %>
  <% contacts.forEach(c => { %>
    <a class="list-item link" href="<%= base %>/contacts/<%= c.id %>">
      <div class="grow">
        <b><%= c.first_name %> <%= c.last_name %></b>
        <%- include('partials/cat_chip', { cat: catById.get(c.category_id) }) %>
        <% if (c.fam_count) { %><span class="small muted">+<%= c.fam_count %> בני משפחה</span><% } %>
        <div class="small muted"><span dir="ltr"><%= c.phone %></span> · <%= birthText(c) %></div>
      </div>
      <div class="small left">
        <% if (c.next) { %>🎂 <b><%= c.next.label %></b> (<%= fmtGreg(c.next.date) %>)<% } %>
        <% if (c.last_contact) { %><div class="muted">קשר אחרון: <%= fmtDate(c.last_contact) %></div><% } %>
      </div>
    </a>
  <% }) %>
</div>
<%- include('partials/foot') %>
