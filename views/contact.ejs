<%- include('partials/head', { title: c.first_name + ' ' + c.last_name, nav: true, active: 'contacts' }) %>
<%
  const nextStr = (n) => n ? `${n.label} — יום ${DAY_NAMES[n.date.getDay()]}, ${fmtGreg(n.date)}${n.age ? ' · ימלאו ' + n.age : ''}${n.note ? ' (' + n.note + ')' : ''}` : '—';
%>
<% if (error) { %><div class="bd-msg bd-msg--err" role="alert"><%= error %></div><% } %>
<div class="bd-layout bd-layout--split">
<div class="bd-stack">
  <section class="bd-card">
    <div class="bd-pagehead" style="margin-bottom:0">
      <div>
        <h1 class="bd-title"><%= c.first_name %> <%= c.last_name %></h1>
        <p class="bd-sub bd-num"><%= c.phone || 'אין טלפון' %></p>
      </div>
      <div class="bd-actions">
        <% const isDemo = typeof demo !== 'undefined' && demo; %>
        <% if (wa && !isDemo) { %><a class="bd-icon-btn bd-icon-btn--wa" href="<%= wa %>" target="_blank" rel="noopener" aria-label="וואטסאפ"><%- include('partials/icons', { name: 'chat' }) %></a><% } %>
        <% if (c.phone && !isDemo) { %><a class="bd-icon-btn" href="tel:+<%= phoneIntl(c.phone) %>" aria-label="חיוג"><%- include('partials/icons', { name: 'phone' }) %></a><% } %>
      </div>
    </div>
    <div class="bd-facts">
      <div class="bd-fact"><b>תאריך לידה</b><span><%= birthText(c) || 'לא הוזן' %></span></div>
      <% if (c.h_day) { %><div class="bd-fact"><b>יום ההולדת הבא</b><span><%= nextStr(c.next) %></span></div><% } %>
      <% if (c.notes) { %><div class="bd-fact"><b>הערות</b><span><%= c.notes %></span></div><% } %>
    </div>
    <form method="post" action="<%= base %>/contacts/<%= c.id %>/category" class="bd-inline">
      <label class="bd-label" for="cat-quick">סיווג</label>
      <select class="bd-input" id="cat-quick" name="category_id" data-autosubmit style="max-width:260px">
        <option value="">— ללא סיווג —</option>
        <% categories.forEach(k => { %><option value="<%= k.id %>" <%= c.category_id === k.id ? 'selected' : '' %>><%= k.name %></option><% }) %>
      </select>
      <noscript><button class="bd-btn bd-btn--ghost bd-btn--sm">שמירה</button></noscript>
    </form>
    <div class="bd-mt"><%- include('partials/remind_select', { action: base + '/contacts/' + c.id + '/remind', value: c.remind_days, id: 'remind', label: '🔔 תזכורת מיוחדת בסמס' }) %></div>
    <p class="bd-help">נשלח לנייד שלכם גם אם תזכורות ה-SMS הכלליות כבויות. בשבת ובחג — ביום החול שלפני. יורד ממכסת ה-SMS לתזכורות.</p>
    <p class="bd-help bd-mt">נוסף <%= link ? 'דרך קישור הרישום "' + link.name + '"' : 'ידנית' %> · <span class="bd-num"><%= fmtDate(c.created_at) %></span></p>
  </section>

  <section class="bd-card" id="family">
    <h2 class="bd-section-title">בני משפחה ויארצייט</h2>
    <% if (!family.length) { %><p class="bd-help bd-mb">לא נרשמו בני משפחה או יארצייט.</p><% } %>
    <ul class="bd-items bd-mb">
    <% family.forEach(f => { const yz = f.kind === 'yahrzeit'; %>
      <li class="bd-item<%= yz ? ' bd-item--yz' : '' %>">
        <div class="bd-item__main">
          <div class="bd-item__title"><%= yz ? '🕯️ ' : '' %><%= f.first_name %><%= yz ? ' ז״ל' : '' %> <span class="bd-status"><%= f.relation %></span><% if (f.remind_days !== null && f.remind_days !== undefined) { %> <span title="יש תזכורת SMS">🔔</span><% } %></div>
          <div class="bd-item__sub"><%= yz ? 'תאריך הפטירה: ' : '' %><%= birthText(f) %></div>
          <div class="bd-item__sub"><%= yz ? 'היארצייט הבא' : 'הבא' %>: <%= yz && f.next ? `${f.next.actualLabel} — יום ${DAY_NAMES[f.next.date.getDay()]}, ${fmtGreg(f.next.date)}${f.next.note ? ' (' + f.next.note + ')' : ''}` : nextStr(f.next) %></div>
        </div>
        <div class="bd-family__ops">
          <%- include('partials/remind_select', { action: base + '/contacts/' + c.id + '/family/' + f.id + '/remind', value: f.remind_days, id: 'remind-f' + f.id, label: yz ? '🔔 תזכורת לפני היארצייט' : '🔔 תזכורת מיוחדת בסמס' }) %>
          <div class="bd-actions">
            <% if (!yz) { %><form method="post" action="<%= base %>/contacts/<%= c.id %>/family/<%= f.id %>/split" data-confirm="להעביר את <%= f.first_name %> לכרטיס מקורב נפרד? התאריכים, התזכורת וסימוני &quot;יצרתי קשר&quot; יעברו איתו."><button class="bd-link-btn bd-link-btn--accent">הפרדה לכרטיס נפרד</button></form><% } %>
            <form method="post" action="<%= base %>/contacts/<%= c.id %>/family/<%= f.id %>/delete" data-confirm="למחוק את <%= f.first_name %>?

⚠️ המחיקה בלתי הפיכה — לא ניתן לשחזר."><button class="bd-link-btn">מחיקה</button></form>
          </div>
        </div>
        <details class="bd-fam-edit">
          <summary class="bd-link-btn bd-link-btn--accent">✏️ עריכת פרטים</summary>
          <form method="post" action="<%= base %>/contacts/<%= c.id %>/family/<%= f.id %>" class="bd-mt">
            <div class="bd-family__grid bd-mb">
              <select class="bd-input" name="relation" aria-label="קרבה"><% RELATIONS.forEach(r => { %><option <%= f.relation === r ? 'selected' : '' %>><%= r %></option><% }) %></select>
              <input class="bd-input" name="first_name" required maxlength="<%= yz ? 80 : 60 %>" value="<%= f.first_name %>" aria-label="<%= yz ? 'שם הנפטר/ת' : 'שם פרטי' %>">
            </div>
            <% if (yz) { %><p class="bd-help bd-mb">תאריך הפטירה:</p><% } %>
            <%- include('partials/birth_fields', { prefix: '', vals: formValues(f), uid: 'ef' + f.id, death: yz }) %>
            <button class="bd-btn bd-btn--primary bd-btn--sm bd-mt">שמירה</button>
          </form>
        </details>
      </li>
    <% }) %>
    </ul>
    <details>
      <summary class="bd-add">+ הוספת בן/בת משפחה</summary>
      <form method="post" action="<%= base %>/contacts/<%= c.id %>/family">
        <div class="bd-family__grid bd-mb">
          <select class="bd-input" name="relation" aria-label="קרבה"><% RELATIONS.forEach(r => { %><option><%= r %></option><% }) %></select>
          <input class="bd-input" name="first_name" required maxlength="60" placeholder="שם פרטי" aria-label="שם פרטי">
        </div>
        <%- include('partials/birth_fields', { prefix: '', vals: { date_type: 'h' }, uid: 'addfam' }) %>
        <button class="bd-btn bd-btn--primary bd-mt">הוספה</button>
      </form>
    </details>
    <details class="bd-mt">
      <summary class="bd-add">+ הוספת יארצייט 🕯️</summary>
      <form method="post" action="<%= base %>/contacts/<%= c.id %>/family">
        <input type="hidden" name="kind" value="yahrzeit">
        <div class="bd-family__grid bd-mb">
          <select class="bd-input" name="relation" aria-label="קרבה"><% RELATIONS.forEach(r => { %><option><%= r %></option><% }) %></select>
          <input class="bd-input" name="first_name" required maxlength="80" placeholder="שם הנפטר/ת (למשל: יצחק בן אברהם)" aria-label="שם הנפטר/ת">
        </div>
        <p class="bd-help bd-mb">תאריך הפטירה:</p>
        <%- include('partials/birth_fields', { prefix: '', vals: { date_type: 'h' }, uid: 'addyz', death: true }) %>
        <p class="bd-help bd-mt">תזכורת SMS לפני היארצייט תיקבע לפי ברירת המחדל בהגדרות, ואפשר לשנות אותה כאן אחרי ההוספה.</p>
        <button class="bd-btn bd-btn--primary bd-mt">הוספת יארצייט</button>
      </form>
    </details>
  </section>

  <section class="bd-card" id="edit">
    <details <%= error ? 'open' : '' %>>
      <summary class="bd-btn bd-btn--ghost">✏️ עריכת פרטים ומחיקה</summary>
      <form method="post" action="<%= base %>/contacts/<%= c.id %>">
        <div class="bd-row2">
          <div class="bd-field"><label class="bd-label" for="e-fn">שם פרטי</label><input class="bd-input" id="e-fn" name="first_name" value="<%= values.first_name %>" maxlength="60"></div>
          <div class="bd-field"><label class="bd-label" for="e-ln">שם משפחה</label><input class="bd-input" id="e-ln" name="last_name" value="<%= values.last_name %>" maxlength="60"></div>
          <p class="bd-help bd-names-note">מספיק שם פרטי <b>או</b> שם משפחה.</p>
        </div>
        <div class="bd-field"><label class="bd-label" for="e-ph">טלפון <span class="opt">(לא חובה)</span></label><input class="bd-input" id="e-ph" name="phone" type="tel" dir="ltr" style="text-align:right" value="<%= values.phone %>"><span class="bd-help">מחו״ל? עם קידומת מדינה, למשל +1 718 555 1234</span></div>
        <fieldset class="bd-field"><legend class="bd-label">תאריך לידה</legend><%- include('partials/birth_fields', { prefix: '', vals: values, uid: 'edit' }) %></fieldset>
        <%- include('partials/cat_select', { selected: values.category_id }) %>
        <div class="bd-field"><label class="bd-label" for="e-notes">הערות</label><textarea class="bd-input" id="e-notes" name="notes" maxlength="1000"><%= values.notes %></textarea><span class="bd-help">⚠️ לא לרשום כאן מידע רפואי או רגיש.</span></div>
        <button class="bd-btn bd-btn--primary">שמירה</button>
      </form>
      <div class="bd-delete-zone">
        <p class="bd-help">מחיקה לצמיתות של <%= [c.first_name, c.last_name].filter(Boolean).join(' ') %><%= family.length ? ' וכל בני המשפחה (' + family.length + ')' : '' %>, כולל היסטוריית הקשר. לא ניתן לשחזר.</p>
        <form method="post" action="<%= base %>/contacts/<%= c.id %>/delete" data-confirm="למחוק את <%= c.first_name %> <%= c.last_name %> וכל בני משפחתו?

⚠️ המחיקה בלתי הפיכה — לא ניתן לשחזר את הפרטים, בני המשפחה והיסטוריית הקשר.">
          <button class="bd-btn bd-btn--danger bd-btn--sm">🗑 מחיקת המקורב</button>
        </form>
      </div>
    </details>
  </section>
</div>

<aside class="bd-card" id="log">
  <h2 class="bd-section-title">יצירת קשר</h2>
  <% if (!log.length) { %><p class="bd-help">עדיין לא נרשמה יצירת קשר.</p><% } %>
  <% if (log.length) { %>
  <div class="bd-chat" data-chat>
  <% log.slice().reverse().forEach(l => { %>
    <div class="bd-bubble">
      <% if (l.member_name) { %><div class="bd-bubble__who"><%= l.member_kind === 'yahrzeit' ? '🕯️ יארצייט של ' + l.member_name + ' ז״ל' : '🎂 יום הולדת של ' + l.member_name %></div><% } %>
      <div class="bd-bubble__text"><%= l.note || '✓ נוצר קשר' %></div>
      <div class="bd-bubble__meta"><span><%= hebStamp(l.created_at) %> · <span class="bd-num" dir="ltr"><%= fmtTime(l.created_at) %></span></span>
        <form method="post" action="<%= base %>/contacts/<%= c.id %>/log/<%= l.id %>/delete" data-confirm="למחוק את הרישום?

⚠️ המחיקה בלתי הפיכה."><button class="bd-bubble__del" aria-label="מחיקת הרישום" title="מחיקה">🗑</button></form>
      </div>
    </div>
  <% }) %>
  </div>
  <% } %>
  <form method="post" action="<%= base %>/contacts/<%= c.id %>/log" class="bd-stack bd-mt">
    <% if (family.length) { %>
    <select class="bd-input" name="family_member_id" aria-label="עם מי">
      <option value="">עם <%= c.first_name %></option>
      <% family.forEach(f => { %><option value="<%= f.id %>"><%= f.kind === 'yahrzeit' ? 'יארצייט של ' + f.first_name + ' ז״ל' : 'יום הולדת של ' + f.first_name %> (<%= f.relation %>)</option><% }) %>
    </select>
    <% } %>
    <input class="bd-input" name="note" placeholder="הערה (לא חובה)" maxlength="500" aria-label="הערה">
    <button class="bd-btn bd-btn--primary bd-btn--block" style="min-height:var(--bd-tap);font-size:var(--bd-fs-md)"><%- include('partials/icons', { name: 'check' }) %>יצרתי קשר</button>
  </form>
</aside>
</div>
<%- include('partials/foot') %>
