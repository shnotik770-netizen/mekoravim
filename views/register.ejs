<%- include('partials/head', internal
  ? { title: 'מקורב חדש', nav: true, active: 'new' }
  : { title: 'רישום — ' + link.shliach_name, narrow: true }) %>
<% if (!internal) { %>
<div class="bd-center bd-mb" style="margin-bottom:24px">
  <%- include('partials/logo', { big: true }) %>
  <h1 class="bd-title"><%= link.shliach_name %></h1>
  <p class="bd-sub" style="font-size:var(--bd-fs-md)">נשמח לדעת מתי יום ההולדת שלך — כדי לאחל לך מזל טוב ביום המיוחד!</p>
</div>
<% } else { %>
<div class="bd-pagehead"><h1 class="bd-title">הוספת מקורב</h1></div>
<a class="bd-card bd-import-cta" href="<%= base %>/contacts/import">
  <span class="bd-import-cta__ico">📋</span>
  <span><b>יש לכם רשימה באקסל?</b><span class="bd-help">מדביקים את כולה בבת אחת — המערכת מזהה שמות, טלפונים ותאריכים.</span></span>
  <span class="bd-import-cta__go">הדבקה מאקסל ←</span>
</a>
<p class="bd-section-title bd-mt">או הוספה של מקורב אחד:</p>
<% } %>
<% if (error) { %><div class="bd-msg bd-msg--err" role="alert"><%= error %></div><% } %>
<form method="post" class="bd-card" novalidate style="<%= internal ? 'max-width:640px' : '' %>">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <div class="<%= internal ? 'bd-row2' : '' %>">
    <div class="bd-field"><label class="bd-label" for="fn">שם פרטי<span class="req">*</span></label><input class="bd-input" id="fn" name="first_name" value="<%= values.first_name || '' %>" autocomplete="given-name" required maxlength="60"></div>
    <div class="bd-field"><label class="bd-label" for="ln">שם משפחה<span class="req">*</span></label><input class="bd-input" id="ln" name="last_name" value="<%= values.last_name || '' %>" autocomplete="family-name" required maxlength="60"></div>
  </div>
  <div class="bd-field"><label class="bd-label" for="ph">טלפון <span class="opt">(לא חובה)</span></label><input class="bd-input" id="ph" name="phone" type="tel" inputmode="tel" dir="ltr" style="text-align:right" autocomplete="tel" placeholder="050-0000000" value="<%= values.phone || '' %>" maxlength="30"></div>

  <fieldset class="bd-field">
    <legend class="bd-label">תאריך לידה<span class="req">*</span></legend>
    <%- include('partials/birth_fields', { prefix: '', vals: values, uid: 'main' }) %>
  </fieldset>

  <% if (internal) { %>
    <%- include('partials/cat_select', { selected: values.category_id }) %>
    <div class="bd-field"><label class="bd-label" for="notes">הערות <span class="opt">(רשות)</span></label><textarea class="bd-input" id="notes" name="notes" maxlength="1000"><%= values.notes || '' %></textarea></div>
  <% } %>

  <div class="bd-field">
    <span class="bd-label">בני משפחה <span class="opt">(לא חובה)</span></span>
    <div id="fam-list">
      <% family.forEach((f, i) => { %><%- include('partials/family_row', { i, f }) %><% }) %>
    </div>
    <button type="button" class="bd-add" id="add-fam">+ הוספת בן/בת משפחה</button>
    <template id="fam-tpl"><%- include('partials/family_row', { i: '__I__', f: { date_type: 'h' } }) %></template>
  </div>

  <button class="bd-btn bd-btn--primary bd-btn--block"><%= internal ? 'שמירה' : 'שליחה' %></button>
  <% if (!internal) { %>
  <p class="bd-help bd-center" style="margin-top:12px">🔒 הפרטים נשמרים רק אצל <%= link.shliach_name %>, לצורך ברכה ביום ההולדת, ולא מועברים לאף אחד. כשרושמים בני משפחה — ודאו שהם מסכימים. אפשר לבקש מחיקה בכל עת.</p>
  <% } %>
</form>
<%- include('partials/foot') %>
