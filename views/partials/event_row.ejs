<%
  const isToday = e.date.getTime() === today.getTime();
  const past = e.date < today;
  const done = e.contacted;
  const intl = phoneIntl(e.contact.phone); // ישראלי או מחו"ל
  const first = e.member ? e.member.first_name : (e.contact.first_name || e.contact.last_name);
  const yz = !!e.yahrzeit;
  // יארצייט: ההודעה נשלחת לקרוב (המקורב), לא "מזל טוב"
  const fem = yz && ['אמא', 'סבתא', 'אחות', 'בת'].includes(e.member.relation);
  const bm = !!e.barmitzvah;
  const msg = bm
    ? (e.member ? `מזל טוב לבר המצווה של ${first}! 🎉 שתזכו לרוב נחת יהודי חסידי ממנו.` : `מזל טוב לבר המצווה, ${first}! 🎉 שתזכה להיות חסיד, ירא שמים ולמדן.`)
    : yz
    ? `שלום ${e.contact.first_name || e.contact.last_name}, רציתי להזכיר שב${e.actualLabel} (יום ${DAY_NAMES[e.date.getDay()]}) חל היארצייט של ${first} ז״ל. ${fem ? 'יהי זכרה ברוך' : 'יהי זכרו ברוך'} 🕯️`
    : 'מזל טוב ' + first + '! 🎂 מאחלים לך שנה טובה ומבורכת, מלאה בבריאות, שמחה והצלחה.';
  const wa = intl ? 'https://wa.me/' + intl + '?text=' + encodeURIComponent(msg) : '';
  const isDemo = typeof demo !== 'undefined' && demo; // בהדגמה: וואטסאפ בלי מספר (רק נוסח הברכה), בלי חיוג
  const waHref = isDemo && wa ? 'https://wa.me/?text=' + encodeURIComponent(msg) : wa;
  const cls = ['bd-row', yz && 'bd-row--yz', isToday && 'bd-row--today', past && !done && 'bd-row--overdue', done && 'bd-row--done'].filter(Boolean).join(' ');
  const iso = e.date.getFullYear() + '-' + String(e.date.getMonth() + 1).padStart(2, '0') + '-' + String(e.date.getDate()).padStart(2, '0');
  const cat = catById.get(e.contact.category_id);
%>
<li class="<%= cls %>">
  <div class="bd-row__date">
    <span class="bd-row__dow"><%= isToday ? 'היום' : 'יום ' + DAY_NAMES[e.date.getDay()] %></span>
    <span class="bd-row__heb"><%= e.label %></span>
    <span class="bd-row__greg bd-num"><%= e.date.getDate() %>.<%= e.date.getMonth() + 1 %></span>
    <% if (bm) { %><span class="bd-row__age bd-row__age--bm"><%- include('icons', { name: 'tefillin' }) %>בר מצווה</span>
    <% } else if (e.age && yz) { %><span class="bd-row__age"><%= e.age === 1 ? 'שנה ראשונה' : e.age + ' שנים' %></span>
    <% } else if (e.age) { %><span class="bd-row__age"><%- include('icons', { name: 'cake' }) %>גיל <%= e.age %></span><% } %>
  </div>
  <div class="bd-row__who">
    <div class="bd-row__line">
      <span class="bd-row__name"><a href="<%= base %>/contacts/<%= e.contact.id %>"><%= yz ? '🕯️ ' + e.name + ' ז״ל' : e.name %></a><% if ((e.member || e.contact).remind_days !== null && (e.member || e.contact).remind_days !== undefined) { %> <span title="יש תזכורת SMS">🔔</span><% } %></span>
      <%- include('cat_chip', { cat }) %>
    </div>
    <% if (e.member) { %><div class="bd-kin"><span><%= yz ? 'יארצייט · ' : '👪 ' %><%= e.member.relation %> של <a href="<%= base %>/contacts/<%= e.contact.id %>"><%= e.contact.first_name %> <%= e.contact.last_name %></a></span></div><% } %>
    <div class="bd-row__meta">
      <% if (past && !done) { %><span style="color:var(--bd-bad);font-weight:500">טרם נוצר קשר</span><% } %>
      <% if (e.note) { %><span class="bd-note">ⓘ <%= e.note %></span><% } %>
    </div>
  </div>
  <div class="bd-row__actions">
    <% if (done) { %><button type="button" class="bd-row__toggle" data-row-toggle aria-expanded="false" aria-label="פרטים ופעולות ל<%= e.name %>">▾</button><% } %>
    <% if (wa) { %>
      <a class="bd-icon-btn bd-icon-btn--wa" href="<%= waHref %>" target="_blank" rel="noopener" aria-label="<%= yz ? 'הודעה בוואטסאפ ל' + e.contact.first_name : 'שליחת ברכה בוואטסאפ ל' + e.name %>"><%- include('icons', { name: 'chat' }) %></a>
      <% if (!isDemo) { %><a class="bd-icon-btn" href="tel:+<%= intl %>" aria-label="חיוג ל<%= e.name %>"><%- include('icons', { name: 'phone' }) %></a><% } %>
    <% } %>
    <form method="post" action="<%= base %>/contacts/<%= e.contact.id %>/<%= done ? 'unlog' : 'log' %>"<% if (!done) { %> data-quicklog data-name="<%= e.name %>"<% } %>>
      <input type="hidden" name="back" value="<%= back %>">
      <input type="hidden" name="date" value="<%= iso %>">
      <% if (e.member) { %><input type="hidden" name="family_member_id" value="<%= e.member.id %>"><% } %>
      <% if (done) { %>
        <button class="bd-done-pill" aria-label="בטל סימון נוצר קשר"><%- include('icons', { name: 'check' }) %>נוצר קשר</button>
      <% } else { %>
        <button class="bd-btn bd-btn--sm <%= isToday || past ? 'bd-btn--primary' : 'bd-btn--ghost' %>">יצרתי קשר</button>
      <% } %>
    </form>
  </div>
</li>
