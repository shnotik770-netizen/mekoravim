<%
  const isToday = e.date.getTime() === today.getTime();
  const past = e.date < today;
  const wa = e.contact.phone ? ('https://wa.me/' + e.contact.phone.replace(/\D/g,'').replace(/^0/,'972')) : '';
%>
<div class="ev <%= isToday ? 'today' : '' %> <%= past ? 'past' : '' %> <%= e.contacted ? 'done' : '' %>">
  <div class="ev-date">
    <div class="dn"><%= isToday ? 'היום' : 'יום ' + DAY_NAMES[e.date.getDay()] %></div>
    <div class="dd"><%= e.date.getDate() %>.<%= e.date.getMonth() + 1 %></div>
  </div>
  <div class="ev-main">
    <a class="ev-name" href="<%= base %>/contacts/<%= e.contact.id %>"><%= e.name %></a>
    <% if (e.sub) { %><div class="small muted"><%= e.sub %></div><% } %>
    <div class="small">
      <span class="tag <%= e.kind === 'hebrew' ? 'heb' : 'greg' %>"><%= e.kind === 'hebrew' ? 'עברי · ' + e.label : 'לועזי' %></span>
      <% if (e.age) { %><span class="age">בן/בת <%= e.age %></span><% } %>
    </div>
  </div>
  <div class="ev-actions">
    <% if (wa) { %><a class="icon-btn" href="<%= wa %>" target="_blank" rel="noopener" title="וואטסאפ">💬</a><a class="icon-btn" href="tel:<%= e.contact.phone %>" title="חיוג">📞</a><% } %>
    <% if (e.contacted) { %>
      <span class="tag ok">✓ נוצר קשר</span>
    <% } else { %>
      <form method="post" action="<%= base %>/contacts/<%= e.contact.id %>/log">
        <input type="hidden" name="back" value="dashboard">
        <% if (e.member) { %><input type="hidden" name="family_member_id" value="<%= e.member.id %>"><% } %>
        <button class="btn small">יצרתי קשר</button>
      </form>
    <% } %>
  </div>
</div>
