<%
  const _title = typeof title !== 'undefined' ? title : 'ימי הולדת למקורבים';
  const _active = typeof active !== 'undefined' ? active : '';
  const _narrow = typeof narrow !== 'undefined' && narrow;
  const _nav = typeof nav !== 'undefined' && nav;
%>
<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title><%= _title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/components.css">
<link rel="stylesheet" href="/css/app.css">
<% if (typeof noApp === 'undefined' || !noApp) { %>
<link rel="manifest" href="<%= typeof manifestUrl !== 'undefined' ? manifestUrl : '/manifest.webmanifest' %>">
<meta name="theme-color" content="#C98A1A">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="ימי הולדת">
<% } %>
<link rel="icon" type="image/png" href="/icons/favicon-64.png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
</head>
<body>
<div class="bd-page">
<% if (typeof demo !== 'undefined' && demo) { %>
<div class="bd-demo-bar" role="note">
  <span>🎭 <b>חשבון הדגמה</b> — לחצו על הכול, שום דבר לא נשמר</span>
  <span class="bd-demo-bar__acts"><a href="/">לדף הבית</a><a class="bd-demo-bar__wa" href="https://wa.me/972533404770?text=<%= encodeURIComponent('שלום, ראיתי את ההדגמה ואשמח לשמוע על מערכת ימי הולדת למקורבים') %>" target="_blank" rel="noopener">💬 יצירת קשר בוואטסאפ</a></span>
</div>
<% } %>
<div class="bd <%= _narrow ? 'bd-narrow' : 'bd-wrap' %>">
<% if (_nav) { %>
<header class="bd-appbar">
  <a class="bd-brand" href="<%= base %>"><%- include('logo') %><%= shliach.name %></a>
  <nav class="bd-nav" aria-label="ניווט ראשי">
    <a href="<%= base %>" <%- _active === 'dashboard' ? 'aria-current="page"' : '' %>>דשבורד</a>
    <a href="<%= base %>/contacts" <%- _active === 'contacts' ? 'aria-current="page"' : '' %>>מקורבים</a>
    <a href="<%= base %>/contacts/new" <%- _active === 'new' ? 'aria-current="page"' : '' %>>+ הוספה</a>
    <a href="<%= base %>/links" <%- _active === 'links' ? 'aria-current="page"' : '' %>>קישורי רישום</a>
    <a href="<%= base %>/settings" <%- _active === 'settings' ? 'aria-current="page"' : '' %>>הגדרות</a>
    <button type="button" class="bd-install" data-install hidden>📲 שמירה כאפליקציה</button>
    <% if (typeof demo !== 'undefined' && demo) { %><a href="/" class="bd-link-btn--accent">יציאה</a><% } else { %><form method="post" action="<%= base %>/logout"><button class="bd-link-btn bd-link-btn--accent" style="padding:0 12px">יציאה</button></form><% } %>
  </nav>
</header>
<% } %>
<main>
<% if (flash && flash.err) { %><div class="bd-msg bd-msg--err" role="alert"><%= flash.err %></div><% } else if (flash) { %><div class="bd-msg bd-msg--ok" role="status">✓ <%= flash %></div><% } %>
