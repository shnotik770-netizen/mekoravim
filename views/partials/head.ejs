<%
  const _title = typeof title !== 'undefined' ? title : 'זכרתי התקשרתי';
  const _active = typeof active !== 'undefined' ? active : '';
  const _narrow = typeof narrow !== 'undefined' && narrow;
  const _nav = typeof nav !== 'undefined' && nav;
%>
<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title><%= _title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/tokens.css?v=<%= v %>">
<link rel="stylesheet" href="/css/components.css?v=<%= v %>">
<link rel="stylesheet" href="/css/app.css?v=<%= v %>">
<% if (typeof noApp === 'undefined' || !noApp) { %>
<link rel="manifest" href="<%= typeof manifestUrl !== 'undefined' ? manifestUrl : '/manifest.webmanifest' %>">
<meta name="theme-color" content="#C98A1A">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="זכרתי התקשרתי">
<% } %>
<link rel="icon" type="image/svg+xml" href="/img/logo.svg?v=<%= v %>">
<link rel="icon" type="image/png" href="/icons/favicon-64.png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
</head>
<body>
<div class="bd-page">
<% if (typeof demo !== 'undefined' && demo) { %>
<div class="bd-demo-bar" role="note">
  <span>🎭 <b>חשבון הדגמה</b> — לחצו על הכול, שום דבר לא נשמר</span>
  <span class="bd-demo-bar__acts"><a href="/">לדף הבית</a><a class="bd-demo-bar__wa" href="https://wa.me/972533404770?text=<%= encodeURIComponent('שלום, ראיתי את ההדגמה ואשמח לשמוע על זכרתי התקשרתי') %>" target="_blank" rel="noopener">💬 יצירת קשר בוואטסאפ</a></span>
</div>
<% } %>
<div class="bd <%= _narrow ? 'bd-narrow' : 'bd-wrap' %>">
<% if (_nav) { %>
<header class="bd-appbar">
  <a class="bd-brand" href="<%= base %>"><%- include('logo') %><span class="bd-brand__text"><span class="bd-brand__name"><%= shliach.name %></span><span class="bd-brand__slogan">זכרתי התקשרתי · לא מפספסים אף יום הולדת</span></span></a>
  <div class="bd-appbar__tools">
    <button type="button" class="bd-install" data-install hidden>📲 שמירה כאפליקציה</button>
    <% if (typeof demo !== 'undefined' && demo) { %><a href="/" class="bd-tool-btn" aria-label="יציאה"><%- include('icons', { name: 'logout' }) %></a><% } else { %><form method="post" action="<%= base %>/logout"><button class="bd-tool-btn" aria-label="יציאה" title="יציאה"><%- include('icons', { name: 'logout' }) %></button></form><% } %>
  </div>
  <nav class="bd-tabs" aria-label="ניווט ראשי">
    <% [['dashboard', '', 'home', 'דשבורד'], ['contacts', '/contacts', 'users', 'מקורבים'], ['new', '/contacts/new', 'plus', 'הוספה'], ['links', '/links', 'link', 'קישורי רישום'], ['settings', '/settings', 'settings', 'הגדרות']].forEach(([key, path, icon, label]) => { %>
    <a href="<%= base + path %>" class="bd-tab <%= key === 'new' ? 'bd-tab--add' : '' %>" <%- _active === key ? 'aria-current="page"' : '' %>><span class="bd-tab__ico"><%- include('icons', { name: icon }) %></span><span class="bd-tab__label"><%= label %></span></a>
    <% }) %>
  </nav>
</header>
<% } %>
<main>
<% if (flash && flash.err) { %><div class="bd-msg bd-msg--err" role="alert"><%= flash.err %></div><% } else if (flash) { %><div class="bd-msg bd-msg--ok" role="status">✓ <%= flash %></div><% } %>
