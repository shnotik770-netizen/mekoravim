<%# בורר תזכורת SMS (0–30 ימים לפני). משתנים: action, value, id, label %>
<form method="post" action="<%= action %>" class="bd-inline bd-remind">
  <label class="bd-label" for="<%= id %>"><%= label %></label>
  <select class="bd-input" id="<%= id %>" name="remind_days" data-autosubmit>
    <option value="" <%= value === null || value === undefined ? 'selected' : '' %>>בלי תזכורת</option>
    <option value="0" <%= value === 0 ? 'selected' : '' %>>ביום עצמו</option>
    <option value="1" <%= value === 1 ? 'selected' : '' %>>יום לפני</option>
    <% [2, 3, 4, 5, 6, 7, 10, 14, 21, 30].forEach(d => { %><option value="<%= d %>" <%= value === d ? 'selected' : '' %>><%= { 7: 'שבוע', 14: 'שבועיים', 21: '3 שבועות', 30: 'חודש' }[d] || d + ' ימים' %> לפני</option><% }) %>
  </select>
  <noscript><button class="bd-btn bd-btn--ghost bd-btn--sm">שמירה</button></noscript>
</form>
