<%- include('partials/head', { title: 'ניהול שלוחים' }) %>
<header class="bd-appbar">
  <span class="bd-brand"><%- include('partials/logo') %>ניהול שלוחים</span>
  <nav class="bd-nav"><button type="button" class="bd-install" data-install hidden>📲 שמירה כאפליקציה</button><form method="post" action="/admin/logout"><button class="bd-link-btn bd-link-btn--accent" style="padding:0 12px">יציאה</button></form></nav>
</header>
<p class="bd-mb"><span class="bd-status <%= smsOn ? 'bd-status--ok' : 'bd-status--bad' %>">SMS ימות המשיח: <%= smsOn ? 'מחובר' : 'לא מוגדר (YEMOT_TOKEN)' %></span></p>

<% if (info) { %>
<section class="bd-card bd-highlight bd-mb">
  <h2 class="bd-section-title">פרטי הכניסה של <%= info.name %></h2>
  <p class="bd-mb">קישור קבוע: <code class="bd-code copy"><%= base %>/s/<%= info.slug %></code></p>
  <% if (info.code) { %>
    <p>קוד כניסה: <code class="bd-code bd-code--big copy"><%= info.code %></code></p>
    <p class="bd-help bd-mt">הקוד מוצג עכשיו בלבד — העבירו אותו לשליח. השליח יכול להחליף אותו בהגדרות.</p>
  <% } else { %>
    <p class="bd-help">כניסה בקוד חד-פעמי שנשלח ב-SMS לנייד השליח בכל כניסה.</p>
  <% } %>
  <a class="bd-btn bd-btn--soft bd-btn--sm bd-mt" target="_blank" rel="noopener" href="https://wa.me/<%= info.phone ? '972' + info.phone.replace(/^0/, '') : '' %>?text=<%= encodeURIComponent('הקישור שלך למערכת ימי ההולדת: ' + base + '/s/' + info.slug + (info.code ? '\nקוד כניסה: ' + info.code : '')) %>">💬 שליחה בוואטסאפ<%= info.phone ? ' ל-' + info.phone : '' %></a>
</section>
<% } %>

<div class="bd-layout bd-layout--split">
<section class="bd-card">
  <h2 class="bd-section-title">שלוחים <span class="bd-muted bd-num" style="font-weight:400">(<%= shluchim.length %>)</span></h2>
  <p class="bd-help bd-mb">כאן רואים רק שם וקישור. רשימות המקורבים לא מוצגות למנהל.</p>
  <% if (!shluchim.length) { %><div class="bd-empty">עדיין אין שלוחים.</div><% } %>
  <ul class="bd-items">
  <% shluchim.forEach(s => { %>
    <li class="bd-item <%= s.active ? '' : 'bd-item--off' %>">
      <div class="bd-item__main">
        <div class="bd-item__title"><%= s.name %>
          <span class="bd-status bd-status--ok"><%= s.login_mode === 'code' ? '🔒 קוד קבוע' : '🔐 קוד ב-SMS' %></span>
          <% if (s.sms_enabled) { %><span class="bd-status bd-status--accent">📱 SMS</span><% } %>
          <% if (!s.active) { %><span class="bd-status bd-status--bad">מושבת</span><% } %></div>
        <div class="bd-item__sub">
          <% if (s.phone) { %><a href="https://wa.me/972<%= s.phone.replace(/^0/, '') %>" target="_blank" rel="noopener" class="bd-num">📱 <%= s.phone %></a> · <% } else { %><span class="bd-status bd-status--bad">חסר טלפון</span> <% } %>
          <code class="bd-code copy"><%= base %>/s/<%= s.slug %></code>
        </div>
      </div>
      <details class="bd-menu">
        <summary class="bd-btn bd-btn--ghost bd-btn--sm">פעולות ▾</summary>
        <div class="bd-menu__body">
          <form method="post" action="/admin/shluchim/<%= s.id %>/send-link" <% if (s.login_mode === 'code') { %>data-confirm="בכניסה בקוד קבוע ייקבע קוד חדש וישלח יחד עם הקישור. להמשיך?"<% } %>>
            <button class="bd-btn bd-btn--soft bd-btn--sm" <%= smsOn && s.phone ? '' : 'disabled' %>>📩 שליחת הקישור ב-SMS<%= s.login_mode === 'code' ? ' (עם קוד חדש)' : '' %></button>
          </form>
          <form method="post" action="/admin/shluchim/<%= s.id %>/login" class="bd-stack" data-login-mode>
            <div class="bd-toggle" role="radiogroup" aria-label="אופן כניסה">
              <input type="radio" name="login_mode" id="lm-otp-<%= s.id %>" value="otp" <%= s.login_mode === 'otp' ? 'checked' : '' %>><label for="lm-otp-<%= s.id %>">קוד ב-SMS</label>
              <input type="radio" name="login_mode" id="lm-code-<%= s.id %>" value="code" <%= s.login_mode === 'code' ? 'checked' : '' %>><label for="lm-code-<%= s.id %>">קוד קבוע</label>
            </div>
            <input class="bd-input code-field" name="code" placeholder="קוד חדש (ריק = אקראי)" maxlength="32" autocomplete="off" aria-label="קוד חדש">
            <button class="bd-btn bd-btn--primary bd-btn--sm">עדכון אופן כניסה ושליחה ב-SMS</button>
          </form>
          <form method="post" action="/admin/shluchim/<%= s.id %>/phone" class="bd-stack">
            <input class="bd-input" name="phone" type="tel" dir="ltr" style="text-align:right" value="<%= s.phone %>" placeholder="נייד השליח" required aria-label="נייד השליח">
            <button class="bd-btn bd-btn--ghost bd-btn--sm">עדכון טלפון</button>
          </form>
          <form method="post" action="/admin/shluchim/<%= s.id %>/toggle"><button class="bd-link-btn <%= s.active ? '' : 'bd-link-btn--accent' %>"><%= s.active ? 'השבתת החשבון' : 'הפעלת החשבון' %></button></form>
        </div>
      </details>
    </li>
  <% }) %>
  </ul>
</section>
<aside class="bd-card">
  <h2 class="bd-section-title">שליח חדש</h2>
  <form method="post" action="/admin/shluchim" data-login-mode>
    <div class="bd-field"><label class="bd-label" for="sn">שם השליח / בית חב״ד<span class="req">*</span></label><input class="bd-input" id="sn" name="name" required maxlength="80"></div>
    <div class="bd-field"><label class="bd-label" for="sp">נייד של השליח<span class="req">*</span></label><input class="bd-input" id="sp" name="phone" type="tel" inputmode="tel" dir="ltr" style="text-align:right" placeholder="050-0000000" required pattern="[0-9+\-\s]{9,}"><span class="bd-help">הקישור ופרטי הכניסה יישלחו לנייד הזה ב-SMS מיד עם יצירת החשבון</span></div>
    <fieldset class="bd-field"><legend class="bd-label">אופן כניסה</legend>
    <div class="bd-toggle" role="radiogroup" aria-label="אופן כניסה">
      <input type="radio" name="login_mode" id="nm-otp" value="otp" <%= smsOn ? 'checked' : 'disabled' %>><label for="nm-otp">קוד חד-פעמי ב-SMS</label>
      <input type="radio" name="login_mode" id="nm-code" value="code" <%= smsOn ? '' : 'checked' %>><label for="nm-code">קוד קבוע</label>
    </div>
    <span class="bd-help">אין כניסה בלי קוד. בקוד חד-פעמי — בכל כניסה ממכשיר חדש נשלח קוד לנייד.</span>
    </fieldset>
    <div class="bd-field code-field"><label class="bd-label" for="sc">קוד <span class="opt">(ריק = 6 ספרות אקראיות)</span></label><input class="bd-input" id="sc" name="code" maxlength="32" autocomplete="off"></div>
    <button class="bd-btn bd-btn--primary bd-btn--block" style="min-height:var(--bd-tap);font-size:var(--bd-fs-md)">יצירת חשבון ושליחה ב-SMS</button>
  </form>
</aside>
</div>
<%- include('partials/foot') %>
