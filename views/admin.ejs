<%- include('partials/head', { title: 'ניהול שלוחים' }) %>
<header class="bd-appbar">
  <span class="bd-brand"><%- include('partials/logo') %>ניהול שלוחים</span>
  <nav class="bd-nav"><a href="/admin" aria-current="page">שלוחים</a><a href="/admin/log">יומן פעולות</a><a href="/">🏠 דף הבית</a><button type="button" class="bd-install" data-install hidden>📲 שמירה כאפליקציה</button><form method="post" action="/admin/logout"><button class="bd-link-btn bd-link-btn--accent" style="padding:0 12px">יציאה</button></form></nav>
  <a class="bd-btn bd-btn--primary bd-btn--sm bd-add-shliach" href="#new-shliach" data-focus="#sn">＋ שליח חדש</a>
</header>
<%
  const tile = (k) => `/admin${d === k ? '' : '?d=' + k}#detail`;
  const KIND = { weekly: 'תזכורת שבועית', daily: 'תזכורת יומית', contact: 'תזכורת על מקורב', otp: 'קודי כניסה', admin: 'פרטי כניסה (מנהל)', test: 'הודעות ניסיון' };
  const ago = (t) => { if (!t) return 'אף פעם'; const h = (Date.now() - new Date(t)) / 36e5; return h < 1 ? 'לפני פחות משעה' : h < 24 ? `לפני ${Math.floor(h)} שעות` : `לפני ${Math.floor(h / 24)} ימים`; };
%>
<div class="bd-stats bd-admin-stats">
  <a class="bd-stat" href="<%= tile('shluchim') %>" aria-pressed="<%= d === 'shluchim' %>"><span class="bd-stat__label">שלוחים פעילים</span><span class="bd-stat__value bd-num"><%= summary.active %></span>
    <span class="bd-stat__hint"><span class="bd-num"><%= summary.used30 %></span> השתמשו ב-30 יום</span><span class="bd-stat__more">פירוט ▾</span></a>
  <a class="bd-stat" href="<%= tile('contacts') %>" aria-pressed="<%= d === 'contacts' %>"><span class="bd-stat__label">מקורבים במערכת</span><span class="bd-stat__value bd-num"><%= summary.contacts %></span><span class="bd-stat__more">פירוט ▾</span></a>
  <a class="bd-stat" href="<%= tile('sms') %>" aria-pressed="<%= d === 'sms' %>"><span class="bd-stat__label">יחידות SMS החודש</span><span class="bd-stat__value bd-num"><%= summary.sms_month %></span><span class="bd-stat__more">פירוט ▾</span></a>
  <a class="bd-stat" href="<%= tile('problems') %>" aria-pressed="<%= d === 'problems' %>"><span class="bd-stat__label">תקלות ב-24 שעות</span><span class="bd-stat__value bd-num" <%- summary.problems24 ? 'style="color:var(--bd-bad)"' : '' %>><%= summary.problems24 %></span><span class="bd-stat__more">פירוט ▾</span></a>
</div>
<% if (detail) { %>
<section class="bd-card bd-mb bd-admin-detail" id="detail">
  <div class="bd-card__head"><h2 class="bd-section-title"><%= { shluchim: 'שלוחים — פירוט', contacts: 'מקורבים — פירוט', sms: 'SMS החודש — פירוט', problems: 'תקלות — פירוט' }[d] %></h2><a class="bd-link-btn" href="/admin">סגירה ✕</a></div>
  <% if (d === 'shluchim') { %>
    <div class="bd-minis">
      <span><b class="bd-num"><%= detail.t.total %></b> סה״כ</span><span><b class="bd-num"><%= detail.t.active %></b> פעילים</span><span><b class="bd-num"><%= detail.t.inactive %></b> מושבתים</span>
      <span><b class="bd-num"><%= detail.used30 %></b> השתמשו ב-30 יום</span><span><b class="bd-num"><%= detail.never %></b> לא נכנסו אף פעם</span><span><b class="bd-num"><%= detail.t.new_month %></b> חדשים החודש</span>
    </div>
    <div class="bd-table-wrap"><table class="bd-table"><thead><tr><th>שליח</th><th>פעילות אחרונה</th><th>פעולות ב-30 יום</th><th>נוצר</th></tr></thead><tbody>
      <% detail.rows.forEach(r => { %><tr><td><a href="/admin/shluchim/<%= r.id %>"><%= r.name %></a><% if (!r.active) { %> <span class="bd-status bd-status--bad">מושבת</span><% } %><% if (r.chabad_house) { %><div class="bd-muted bd-small"><%= r.chabad_house %></div><% } %></td>
        <td><%= ago(r.last_seen) %></td><td class="bd-num"><%= r.actions30 %></td><td class="bd-num"><%= fmtDate(r.created_at) %></td></tr><% }) %>
    </tbody></table></div>
  <% } else if (d === 'contacts') { %>
    <div class="bd-minis">
      <span><b class="bd-num"><%= detail.t.contacts %></b> מקורבים</span><span><b class="bd-num"><%= detail.t.family %></b> בני משפחה</span><span><b class="bd-num"><%= detail.t.new30 %></b> נוספו ב-30 יום</span>
      <span><b class="bd-num"><%= detail.t.via_link %></b> נרשמו בקישור</span><span><b class="bd-num"><%= detail.t.reminders %></b> עם תזכורת מיוחדת</span><span><b class="bd-num"><%= detail.t.greetings30 %></b> סימוני "יצרתי קשר" ב-30 יום</span>
    </div>
    <div class="bd-table-wrap"><table class="bd-table"><thead><tr><th>שליח</th><th>מקורבים</th><th>בני משפחה</th><th>חדשים (30 יום)</th><th>"יצרתי קשר" (30 יום)</th></tr></thead><tbody>
      <% detail.rows.forEach(r => { %><tr><td><a href="/admin/shluchim/<%= r.id %>"><%= r.name %></a></td><td class="bd-num"><%= r.contacts %></td><td class="bd-num"><%= r.family %></td><td class="bd-num"><%= r.new30 %></td><td class="bd-num"><%= r.greetings30 %></td></tr><% }) %>
    </tbody></table></div>
  <% } else if (d === 'sms') { %>
    <div class="bd-minis">
      <% if (!detail.kinds.length) { %><span>עוד לא נשלחו הודעות החודש</span><% } %>
      <% detail.kinds.forEach(k => { %><span><b class="bd-num"><%= k.units %></b> <%= KIND[k.kind] || k.kind %> <span class="bd-muted">(<%= k.msgs %> הודעות)</span></span><% }) %>
    </div>
    <% if (detail.months.length) { const mx = Math.max(...detail.months.map(m => m.units), 1); %>
    <div class="bd-months" aria-label="יחידות לפי חודש"><% detail.months.forEach(m => { %><div><span class="bd-num"><%= m.units %></span><i style="height:<%= Math.max(4, Math.round(m.units / mx * 70)) %>px"></i><small class="bd-num"><%= m.m %></small></div><% }) %></div>
    <% } %>
    <div class="bd-table-wrap"><table class="bd-table"><thead><tr><th>שליח</th><th>החודש</th><th>מכסה לתזכורות</th><th>נוצלו</th><th>יתרה</th><th>תזכורות</th></tr></thead><tbody>
      <% detail.rows.forEach(r => { const st = quotaStatus(r); %><tr><td><a href="/admin/shluchim/<%= r.id %>"><%= r.name %></a></td><td class="bd-num"><%= r.month_units %></td><td class="bd-num"><%= st.quota %></td><td class="bd-num"><%= st.used %></td>
        <td class="bd-num" <%- st.low ? 'style="color:var(--bd-bad);font-weight:600"' : '' %>><%= st.left %></td><td><%= [r.sms_weekly && 'שבועי', r.sms_daily && 'יומי'].filter(Boolean).join(' + ') || '—' %></td></tr><% }) %>
    </tbody></table></div>
  <% } else { %>
    <div class="bd-minis"><span><b class="bd-num"><%= summary.problems24 %></b> ב-24 שעות</span><span><b class="bd-num"><%= detail.w.errors7 %></b> שגיאות שרת ב-7 ימים</span><span><b class="bd-num"><%= detail.w.fails7 %></b> כשלים/חסימות ב-7 ימים</span></div>
    <% if (!detail.groups.length) { %><p class="bd-help">👍 אין תקלות ב-24 השעות האחרונות.</p><% } else { %>
    <div class="bd-table-wrap"><table class="bd-table"><thead><tr><th>פעולה</th><th>מי</th><th>תוצאה</th><th>פעמים</th><th>אחרונה</th></tr></thead><tbody>
      <% detail.groups.forEach(g => { %><tr><td><%= g.action %></td><td><%= { system: 'מערכת', public: 'ציבורי', shliach: 'שליח', admin: 'מנהל' }[g.actor] || g.actor %></td><td><%= { error: 'שגיאה', fail: 'נכשל', blocked: 'נחסם' }[g.outcome] || g.outcome %></td><td class="bd-num"><%= g.n %></td><td><%= ago(g.last) %></td></tr><% }) %>
    </tbody></table></div><% } %>
    <a class="bd-btn bd-btn--soft bd-btn--sm bd-mt" href="/admin/log?o=problems">ליומן הפעולות המלא ←</a>
  <% } %>
</section>
<% } %>
<div class="bd-pagehead">
  <span class="bd-status <%= smsOn ? 'bd-status--ok' : 'bd-status--bad' %>">SMS ימות המשיח: <%= smsOn ? 'מחובר' : 'לא מוגדר (YEMOT_TOKEN)' %></span>
  <form method="post" action="/admin/sms-quota" class="bd-inline">
    <label class="bd-small bd-muted" for="dq">מכסת SMS התחלתית לשליח חדש:</label>
    <input class="bd-input bd-num" id="dq" name="quota" type="number" min="0" max="100000" value="<%= defaultQuota %>" required style="flex:0 0 90px">
    <button class="bd-btn bd-btn--ghost bd-btn--sm">שמירה</button>
  </form>
</div>

<% if (info) { %>
<section class="bd-card bd-highlight bd-mb">
  <h2 class="bd-section-title">פרטי הכניסה של <%= info.name %></h2>
  <p class="bd-mb">קישור קבוע: <code class="bd-code copy"><%= base %>/s/<%= info.slug %></code></p>
  <% if (info.code) { %>
    <p>קוד כניסה: <code class="bd-code bd-code--big copy"><%= info.code %></code></p>
    <p class="bd-help bd-mt">הקוד מוצג עכשיו בלבד — העבירו אותו לשליח. השליח יכול להחליף אותו בהגדרות.</p>
  <% } %>
  <a class="bd-btn bd-btn--soft bd-btn--sm bd-mt" target="_blank" rel="noopener" href="https://wa.me/<%= phoneIntl(info.phone) %>?text=<%= encodeURIComponent('הקישור שלך למערכת ימי ההולדת: ' + base + '/s/' + info.slug + (info.code ? '\nקוד כניסה: ' + info.code : '')) %>">💬 שליחה בוואטסאפ<%= info.phone ? ' ל-' + info.phone : '' %></a>
</section>
<% } %>

<div class="bd-layout bd-layout--split">
<section class="bd-card">
  <h2 class="bd-section-title">שלוחים <span class="bd-muted bd-num" style="font-weight:400">(<%= shluchim.length %>)</span></h2>
  <p class="bd-help bd-mb">כאן רואים רק שם וקישור. רשימות המקורבים לא מוצגות למנהל.</p>
  <% if (!shluchim.length) { %><div class="bd-empty">עדיין אין שלוחים.</div><% } %>
  <% if (shluchim.length > 1) { %><div class="bd-search bd-mb"><%- include('partials/icons', { name: 'search' }) %><input class="bd-input" type="search" placeholder="חיפוש שליח לפי שם, בית חב״ד או טלפון…" data-filter="#shluchim-list" aria-label="חיפוש שליח לפי שם, בית חב״ד או טלפון…"></div>
  <p class="bd-help bd-mb" data-filter-empty="#shluchim-list" hidden>לא נמצאו תוצאות.</p>
  <% } %>
  <ul class="bd-items" id="shluchim-list">
  <% shluchim.forEach(s => { %>
    <li class="bd-item <%= s.active ? '' : 'bd-item--off' %>">
      <div class="bd-item__main">
        <div class="bd-item__title"><a href="/admin/shluchim/<%= s.id %>" title="דשבורד שליח"><%= s.name %></a>
          <% if (s.chabad_house) { %><span class="bd-muted" style="font-weight:400">· <%= s.chabad_house %></span><% } %>
          <% if (!s.has_code) { %><span class="bd-status">רק קוד ב-SMS</span><% } %>
          <% const st = quotaStatus(s), kinds = [s.sms_weekly && 'שבועי', s.sms_daily && 'יומי'].filter(Boolean).join('+'); %>
          <span class="bd-status <%= st.low ? 'bd-status--bad' : (kinds ? 'bd-status--accent' : '') %>" title="יחידות SMS לתזכורות: נוצלו מתוך המכסה"><span>📱 <%= kinds ? kinds + ' · ' : '' %><bdi class="bd-num"><%= st.used %>/<%= st.quota %></bdi></span></span>
          <% if (!s.active) { %><span class="bd-status bd-status--bad">מושבת</span><% } %></div>
        <div class="bd-item__sub">
          <% if (s.phone) { %><a href="https://wa.me/<%= phoneIntl(s.phone) %>" target="_blank" rel="noopener" class="bd-num">📱 <%= s.phone %></a> · <% } else { %><span class="bd-status bd-status--bad">חסר טלפון</span> <% } %>
          <code class="bd-code copy"><%= base %>/s/<%= s.slug %></code>
        </div>
      </div>
      <details class="bd-menu">
        <summary class="bd-btn bd-btn--ghost bd-btn--sm">פעולות ▾</summary>
        <div class="bd-menu__body">
          <a class="bd-btn bd-btn--ghost bd-btn--sm" href="/admin/shluchim/<%= s.id %>">📊 דשבורד שליח</a>
          <form method="post" action="/admin/shluchim/<%= s.id %>/send-link">
            <button class="bd-btn bd-btn--soft bd-btn--sm" <%= smsOn && s.phone ? '' : 'disabled' %>>📩 שליחת הקישור ב-SMS</button>
          </form>
          <form method="post" action="/admin/shluchim/<%= s.id %>/code" class="bd-stack" data-confirm="לקבוע קוד חדש? הקוד הקודם יפסיק לעבוד וכל המכשירים ינותקו.">
            <input class="bd-input" name="code" placeholder="קוד חדש (ריק = אקראי)" maxlength="32" autocomplete="off" aria-label="קוד חדש">
            <button class="bd-btn bd-btn--primary bd-btn--sm">קוד חדש ושליחה ב-SMS</button>
          </form>
          <form method="post" action="/admin/shluchim/<%= s.id %>/quota" class="bd-stack">
            <p class="bd-small bd-muted">SMS לתזכורות: הוקצו <b class="bd-num"><%= st.quota %></b> · נוצלו <b class="bd-num"><%= st.used %></b> · יתרה <b class="bd-num"><%= st.left %></b></p>
            <div class="bd-inline">
              <input class="bd-input" name="add" type="number" min="1" max="100000" placeholder="הוספת יחידות" aria-label="הוספת יחידות">
              <button class="bd-btn bd-btn--primary bd-btn--sm">הוספה</button>
            </div>
            <details>
              <summary class="bd-link-btn bd-link-btn--accent">הגדרות מתקדמות</summary>
              <div class="bd-stack">
                <label class="bd-small">מכסה כוללת<input class="bd-input" name="quota" type="number" min="0" max="100000" placeholder="<%= st.quota %>"></label>
                <label class="bd-small">סף התראה (ריק = 10%)<input class="bd-input" name="threshold" type="number" min="0" max="100000" value="<%= s.sms_alert_threshold ?? '' %>" placeholder="<%= st.threshold %>"></label>
                <button class="bd-btn bd-btn--ghost bd-btn--sm">שמירה</button>
              </div>
            </details>
          </form>
          <form method="post" action="/admin/shluchim/<%= s.id %>/house" class="bd-stack">
            <input class="bd-input" name="chabad_house" value="<%= s.chabad_house %>" maxlength="80" placeholder="שם בית חב״ד" aria-label="שם בית חב״ד">
            <button class="bd-btn bd-btn--ghost bd-btn--sm">עדכון שם בית חב״ד</button>
          </form>
          <form method="post" action="/admin/shluchim/<%= s.id %>/phone" class="bd-stack">
            <input class="bd-input" name="phone" type="tel" dir="ltr" style="text-align:right" value="<%= s.phone %>" placeholder="נייד השליח" required aria-label="נייד השליח">
            <button class="bd-btn bd-btn--ghost bd-btn--sm">עדכון טלפון</button>
          </form>
          <form method="post" action="/admin/shluchim/<%= s.id %>/toggle"><button class="bd-link-btn <%= s.active ? '' : 'bd-link-btn--accent' %>"><%= s.active ? 'השבתת החשבון' : 'הפעלת החשבון' %></button></form>
        </div>
      </details>
    </li>
  <% }) %>
  </ul>
</section>
<aside class="bd-card" id="new-shliach">
  <h2 class="bd-section-title">שליח חדש</h2>
  <form method="post" action="/admin/shluchim">
    <div class="bd-field"><label class="bd-label" for="sn">שם השליח / השלוחה<span class="req">*</span></label><input class="bd-input" id="sn" name="name" required maxlength="80"></div>
    <div class="bd-field"><label class="bd-label" for="sa">פנייה</label><select class="bd-input" id="sa" name="address">
      <% ADDRESS_OPTIONS.forEach(([k, label]) => { %><option value="<%= k %>"><%= label %></option><% }) %>
    </select><span class="bd-help">משנה את הברכה ("שלום, הרבנית…") וההודעות. השליח/ה יכול/ה לשנות בהגדרות.</span></div>
    <div class="bd-field"><label class="bd-label" for="sh">שם בית חב״ד <span class="opt">(לא חובה)</span></label><input class="bd-input" id="sh" name="chabad_house" maxlength="80"></div>
    <div class="bd-field"><label class="bd-label" for="sp">נייד של השליח<span class="req">*</span></label><input class="bd-input" id="sp" name="phone" type="tel" inputmode="tel" dir="ltr" style="text-align:right" placeholder="050-0000000" required autocomplete="tel"><span class="bd-help">הקישור ופרטי הכניסה יישלחו לנייד הזה ב-SMS מיד עם יצירת החשבון</span></div>
    <div class="bd-field"><label class="bd-label" for="sc">קוד כניסה קבוע <span class="opt">(ריק = 6 ספרות אקראיות)</span></label><input class="bd-input" id="sc" name="code" maxlength="32" autocomplete="off"><span class="bd-help">השליח יוכל להיכנס עם הקוד הזה, או עם קוד חד-פעמי שיישלח לנייד שלו ב-SMS.</span></div>
    <div class="bd-field"><label class="bd-label" for="sq">מכסת SMS לתזכורות <span class="opt">(ריק = <%= defaultQuota %>)</span></label><input class="bd-input" id="sq" name="sms_quota" type="number" min="0" max="100000" inputmode="numeric"><span class="bd-help">רק תזכורות ימי הולדת יורדות מהמכסה (הודעה ארוכה = כמה יחידות). קודי כניסה והודעות מערכת לא נספרים. אפשר להוסיף יחידות בכל עת מתפריט הפעולות.</span></div>
    <button class="bd-btn bd-btn--primary bd-btn--block" style="min-height:var(--bd-tap);font-size:var(--bd-fs-md)">יצירת חשבון ושליחה ב-SMS</button>
  </form>
</aside>
</div>
<%- include('partials/foot') %>
