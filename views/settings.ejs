<%- include('partials/head', { title: 'הגדרות', nav: true, active: 'settings' }) %>
<div class="bd-head"><h1 class="bd-title">הגדרות</h1></div>
<% if (error) { %><div class="bd-msg bd-msg--err" role="alert"><%= error %></div><% } %>
<div class="bd-layout bd-layout--split">
<div class="bd-stack">
  <section class="bd-card">
    <h2 class="bd-section-title">סיווגי מקורבים</h2>
    <ul class="bd-items bd-mb">
    <% categories.forEach(c => { %>
      <li class="bd-item">
        <form method="post" class="bd-item__main bd-stack">
          <input type="hidden" name="action" value="cat_update"><input type="hidden" name="id" value="<%= c.id %>">
          <div class="bd-inline">
            <input class="bd-input" name="name" value="<%= c.name %>" maxlength="40" required aria-label="שם הסיווג">
            <button class="bd-btn bd-btn--ghost bd-btn--sm">שמירה</button>
          </div>
          <div class="bd-swatches" role="radiogroup" aria-label="צבע">
            <% COLORS.forEach(col => { %><label><input type="radio" name="color" value="<%= col %>" <%= col === c.color ? 'checked' : '' %> aria-label="<%= col %>"><span style="--c:<%= col %>"></span></label><% }) %>
          </div>
        </form>
        <form method="post" data-confirm="למחוק את הסיווג &quot;<%= c.name %>&quot;? המקורבים יישארו ללא סיווג.">
          <input type="hidden" name="action" value="cat_delete"><input type="hidden" name="id" value="<%= c.id %>">
          <button class="bd-link-btn">מחיקה</button>
        </form>
      </li>
    <% }) %>
    </ul>
    <form method="post" class="bd-group bd-stack">
      <input type="hidden" name="action" value="cat_add">
      <div class="bd-inline">
        <input class="bd-input" name="name" placeholder="סיווג חדש" maxlength="40" required aria-label="סיווג חדש">
        <button class="bd-btn bd-btn--primary bd-btn--sm">הוספה</button>
      </div>
      <div class="bd-swatches" role="radiogroup" aria-label="צבע">
        <% COLORS.forEach((col, i) => { %><label><input type="radio" name="color" value="<%= col %>" <%= i === 0 ? 'checked' : '' %> aria-label="<%= col %>"><span style="--c:<%= col %>"></span></label><% }) %>
      </div>
    </form>
  </section>

  <section class="bd-card" id="sms">
    <h2 class="bd-section-title">📱 תזכורות SMS</h2>
    <p class="bd-help bd-mb">תזכורת בבוקר עם ימי ההולדת (מקורבים ובני משפחה). בשבת ובחג לא נשלחות הודעות — ההודעה נשלחת ביום החול שלפני וכוללת גם את ימי השבת/החג.</p>
    <p class="bd-mb"><span class="bd-status <%= quota.low ? 'bd-status--bad' : 'bd-status--accent' %>"><span>יחידות לתזכורות: הוקצו <bdi class="bd-num"><%= quota.quota %></bdi> · נוצלו <bdi class="bd-num"><%= quota.used %></bdi> · יתרה <bdi class="bd-num"><%= quota.left %></bdi></span></span></p>
    <p class="bd-help bd-mb">רק התזכורות יורדות מהיתרה (הודעה ארוכה = כמה יחידות). קודי כניסה והודעות ניסיון על חשבון המערכת. לחידוש המכסה פנו למנהל.</p>
    <% if (!smsOn) { %><div class="bd-msg bd-msg--err">שליחת SMS עדיין לא הופעלה במערכת — פנו למנהל.</div><% } %>
    <form method="post" action="<%= base %>/sms">
      <div class="bd-field"><label class="bd-label" for="sms-ph">מספר נייד לקבלת ההודעה</label><input class="bd-input" id="sms-ph" name="sms_phone" type="tel" dir="ltr" style="text-align:right" inputmode="tel" value="<%= shliach.sms_phone %>" placeholder="050-0000000"></div>
      <fieldset class="bd-field"><legend class="bd-label">אילו תזכורות לשלוח (אפשר את שתיהן)</legend>
        <label class="bd-check"><input type="checkbox" name="sms_weekly" <%= shliach.sms_weekly ? 'checked' : '' %>> <span><b>שבועי</b> — ביום ראשון: כל ימי ההולדת של השבוע</span></label>
        <label class="bd-check bd-mt"><input type="checkbox" name="sms_daily" <%= shliach.sms_daily ? 'checked' : '' %>> <span><b>יומי</b> — כל בוקר: ימי ההולדת של היום (רק בימים שיש)</span></label>
      </fieldset>
      <button class="bd-btn bd-btn--primary bd-mt">שמירה</button>
    </form>
    <% const dmy = (d) => d.split('-').reverse().join('.'); %>
    <% if (shliach.sms_last_sent || shliach.sms_last_daily) { %><p class="bd-help bd-mt">טופל לאחרונה:<% if (shliach.sms_last_sent) { %> שבועי <span class="bd-num"><%= dmy(shliach.sms_last_sent) %></span><% } %><% if (shliach.sms_last_daily) { %> · יומי <span class="bd-num"><%= dmy(shliach.sms_last_daily) %></span><% } %></p><% } %>
    <% if (shliach.sms_last_error) { %><p class="bd-err bd-mt">שגיאה אחרונה: <%= shliach.sms_last_error %></p><% } %>
    <details class="bd-mt">
      <summary class="bd-link-btn bd-link-btn--accent">תצוגה מקדימה של ההודעה</summary>
      <% Object.entries(previews).forEach(([label, text]) => { %><% if (label) { %><p class="bd-label bd-mt"><%= label %></p><% } %><pre class="bd-sms-preview"><%= text %></pre><% }) %>
    </details>
    <% if (smsOn && shliach.sms_phone) { %>
    <form method="post" action="<%= base %>/sms" class="bd-mt">
      <input type="hidden" name="action" value="test">
      <button class="bd-btn bd-btn--ghost bd-btn--sm">שליחת הודעת ניסיון עכשיו</button>
    </form>
    <% } %>
  </section>
</div>

<aside class="bd-card">
  <h2 class="bd-section-title">החלפת קוד כניסה</h2>
  <p class="bd-help bd-mb">החלפת הקוד מנתקת את כל שאר המכשירים המחוברים.<% if (canOtp) { %> אפשר תמיד להיכנס גם עם קוד חד-פעמי שנשלח ב-SMS לנייד <bdi class="bd-num" dir="ltr"><%= shliach.phone %></bdi>.<% } %></p>
  <form method="post">
    <input type="hidden" name="action" value="code">
    <% if (needCurrent) { %><div class="bd-field"><label class="bd-label" for="cur">קוד נוכחי</label><input class="bd-input" id="cur" type="password" name="current" required autocomplete="current-password"><span class="bd-help">שכחתם? צאו מהחשבון, היכנסו עם קוד חד-פעמי ב-SMS, ואז אפשר לקבוע קוד חדש בלי הקוד הנוכחי.</span></div><% } %>
    <div class="bd-field"><label class="bd-label" for="nc">קוד חדש</label><input class="bd-input" id="nc" type="password" name="code" required minlength="6" autocomplete="new-password"><span class="bd-help">6 תווים לפחות, לא רצף ולא תו חוזר</span></div>
    <div class="bd-field"><label class="bd-label" for="nc2">אימות</label><input class="bd-input" id="nc2" type="password" name="code2" required minlength="6" autocomplete="new-password"></div>
    <button class="bd-btn bd-btn--primary bd-btn--block" style="min-height:var(--bd-tap);font-size:var(--bd-fs-md)">שמירה</button>
  </form>
</aside>
</div>
<%- include('partials/foot') %>
