<%- include('partials/head', { title: s.name + ' — דשבורד' }) %>
<%
  const ago = (d) => d ? fmtTime(d) : '—';
  const kindName = { limit: 'התראת מכסת רשומות', weekly: 'תזכורת שבועית', daily: 'תזכורת יומית', contact: 'תזכורת על מקורב', otp: 'קודי כניסה', admin: 'פרטי כניסה (מנהל)', test: 'הודעות ניסיון' };
  const pct = bdays.past30 ? Math.round(bdays.covered30 / bdays.past30 * 100) : null;
  const alertCls = { bad: 'bd-msg--err', warn: 'bd-msg--warn', info: 'bd-msg--info' };
%>
<header class="bd-appbar">
  <a class="bd-brand" href="/admin"><%- include('partials/logo') %>ניהול שלוחים</a>
  <%- include('partials/admin_nav', { cur: '' }) %>
</header>
<div class="bd-pagehead">
  <div>
    <h1 class="bd-title"><%= s.name %></h1>
    <p class="bd-sub"><%= s.chabad_house || '' %><%= s.chabad_house ? ' · ' : '' %>נפתח <span class="bd-num" dir="ltr"><%= fmtTime(s.created_at) %></span>
      <% if (!s.active) { %> · <span class="bd-status bd-status--bad">מושבת</span><% } %></p>
  </div>
  <form method="get" action="/admin/shluchim/go" class="bd-inline">
    <select class="bd-input" name="id" aria-label="מעבר לשליח אחר" data-autosubmit>
      <% all.forEach(x => { %><option value="<%= x.id %>" <%= x.id === s.id ? 'selected' : '' %>><%= x.name %></option><% }) %>
    </select>
    <noscript><button class="bd-btn bd-btn--ghost bd-btn--sm">מעבר</button></noscript>
  </form>
</div>
<p class="bd-help bd-mb">דשבורד למנהל — רק מספרים ופעולות, בלי שמות, טלפונים או פרטים של מקורבים.</p>
<%- include('partials/reveal', { info }) %>

<details class="bd-card bd-mb bd-admin-actions bd-fold" id="actions" open data-fold><summary class="bd-section-title">פעולות ופרטי השליח</summary>
  <div class="bd-actions-grid">
    <div class="bd-action-box">
      <b>👤 פרטי השליח</b>
      <p class="bd-small"><%= displayName(s) %><%= s.chabad_house ? ' · ' + s.chabad_house : '' %></p>
      <% if (s.phone) { %><p class="bd-num" dir="ltr" style="text-align:right"><%= s.phone %> <span class="bd-help" dir="rtl">(כניסה ותזכורות SMS)</span></p>
        <div class="bd-inline">
          <a class="bd-btn bd-btn--soft bd-btn--sm" href="https://wa.me/<%= phoneIntl(s.phone) %>" target="_blank" rel="noopener">💬 וואטסאפ</a>
          <a class="bd-btn bd-btn--ghost bd-btn--sm" href="tel:+<%= phoneIntl(s.phone) %>">📞 חיוג</a>
        </div>
      <% } else { %><p class="bd-err">אין נייד לשליח</p><% } %>
      <details class="bd-mt">
        <summary class="bd-link-btn bd-link-btn--accent">✏️ עריכת פרטים</summary>
        <form method="post" action="/admin/shluchim/<%= s.id %>/details" class="bd-stack">
          <label class="bd-small">שם<input class="bd-input" name="name" value="<%= s.name %>" maxlength="80" required></label>
          <label class="bd-small">פנייה (תואר)<select class="bd-input" name="address">
            <% ADDRESS_OPTIONS.forEach(([k, label]) => { %><option value="<%= k %>" <%= addressKey(s) === k ? 'selected' : '' %>><%= label %></option><% }) %>
          </select></label>
          <label class="bd-small">בית חב״ד<input class="bd-input" name="chabad_house" value="<%= s.chabad_house %>" maxlength="80"></label>
          <label class="bd-small">נייד (כניסה ותזכורות SMS)<input class="bd-input" name="phone" type="tel" dir="ltr" style="text-align:right" value="<%= s.phone %>" required></label>
          <p class="bd-help">שינוי הנייד מנתק את השליח מכל המכשירים.</p>
          <button class="bd-btn bd-btn--primary bd-btn--sm">שמירת הפרטים</button>
        </form>
      </details>
    </div>
    <div class="bd-action-box">
      <b>🔗 כניסה לחשבון</b>
      <p class="bd-help">הקישור האישי של השליח (לא להעביר לאחרים).</p>
      <div class="bd-inline">
        <button type="button" class="bd-btn bd-btn--ghost bd-btn--sm bd-copy-btn" data-copy="<%= base %>/s/<%= s.slug %>"><span>העתקת הקישור</span></button>
        <form method="post" action="/admin/shluchim/<%= s.id %>/send-link"><button class="bd-btn bd-btn--soft bd-btn--sm" <%= smsOn && s.phone ? '' : 'disabled' %>>📩 שליחת הקישור ב-SMS</button></form>
      </div>
      <form method="post" action="/admin/shluchim/<%= s.id %>/code" class="bd-inline bd-mt" data-confirm="לקבוע קוד חדש? הקוד הקודם יפסיק לעבוד וכל המכשירים ינותקו.">
        <input class="bd-input" name="code" placeholder="קוד חדש (ריק = אקראי)" maxlength="32" autocomplete="off" aria-label="קוד חדש">
        <button class="bd-btn bd-btn--primary bd-btn--sm">קוד חדש + SMS</button>
      </form>
      <% if (!s.has_code) { %><p class="bd-help">לשליח אין קוד קבוע — נכנס רק בקוד חד-פעמי ב-SMS.</p><% } %>
    </div>
    <div class="bd-action-box">
      <b>📱 SMS לתזכורות</b>
      <p class="bd-small">הוקצו <b class="bd-num"><%= quota.quota %></b> · נוצלו <b class="bd-num"><%= quota.used %></b> · יתרה <b class="bd-num <%= quota.low ? 'bd-err' : '' %>"><%= quota.left %></b></p>
      <form method="post" action="/admin/shluchim/<%= s.id %>/quota" class="bd-stack">
        <div class="bd-inline">
          <input class="bd-input" name="add" type="number" min="1" max="100000" placeholder="הוספת יחידות (למשל 1000)" aria-label="הוספת יחידות">
          <button class="bd-btn bd-btn--primary bd-btn--sm">הוספה</button>
        </div>
        <details>
          <summary class="bd-link-btn bd-link-btn--accent">הגדרות מתקדמות</summary>
          <div class="bd-stack">
            <label class="bd-small">מכסה כוללת<input class="bd-input" name="quota" type="number" min="0" max="100000" placeholder="<%= quota.quota %>"></label>
            <label class="bd-small">סף התראה (ריק = 10%)<input class="bd-input" name="threshold" type="number" min="0" max="100000" value="<%= s.sms_alert_threshold ?? '' %>" placeholder="<%= quota.threshold %>"></label>
            <button class="bd-btn bd-btn--ghost bd-btn--sm">שמירה</button>
          </div>
        </details>
      </form>
    </div>
    <div class="bd-action-box">
      <b id="records">📇 מכסת רשומות</b>
      <p class="bd-small">מכסה <b class="bd-num"><%= records.quota %></b> · בשימוש <b class="bd-num"><%= records.used %></b> · נותרו <b class="bd-num <%= records.near ? 'bd-err' : '' %>"><%= records.left %></b></p>
      <div class="bd-meter <%= records.near ? 'bd-meter--low' : '' %>" aria-hidden="true"><span style="width:<%= Math.min(100, Math.round(records.used / Math.max(1, records.quota) * 100)) %>%"></span></div>
      <form method="post" action="/admin/shluchim/<%= s.id %>/records" class="bd-stack bd-mt">
        <div class="bd-inline">
          <input class="bd-input" name="add" type="number" min="1" max="100000" placeholder="הוספת רשומות (למשל 500)" aria-label="הוספת רשומות">
          <button class="bd-btn bd-btn--primary bd-btn--sm">הוספה</button>
        </div>
      </form>
      <details>
        <summary class="bd-link-btn bd-link-btn--accent">הגדרות מתקדמות</summary>
        <form method="post" action="/admin/shluchim/<%= s.id %>/records" class="bd-stack">
          <label class="bd-small">מכסה כוללת<input class="bd-input bd-num" name="quota" type="number" min="0" max="1000000" value="<%= records.quota %>"></label>
          <button class="bd-btn bd-btn--ghost bd-btn--sm">שמירה</button>
        </form>
      </details>
      <p class="bd-help">מקורבים, בני משפחה ויארצייט. כשהמכסה מלאה אי אפשר להוסיף רשומות (גם לא בקישורי הרישום).</p>
    </div>
    <div class="bd-action-box">
      <b>⚙️ חשבון</b>
      <form method="post" action="/admin/shluchim/<%= s.id %>/toggle" data-confirm="<%= s.active ? 'להשבית את החשבון? השליח לא יוכל להיכנס והתזכורות ייעצרו.' : 'להפעיל מחדש את החשבון?' %>">
        <button class="bd-btn bd-btn--sm <%= s.active ? 'bd-btn--ghost' : 'bd-btn--primary' %>"><%= s.active ? '⏸ השבתת החשבון' : '▶ הפעלת החשבון' %></button>
      </form>
    </div>
  </div>
</details>

<details class="bd-card bd-mb bd-fold" open data-fold><summary class="bd-section-title">בריאות החשבון</summary>
  <% if (!alerts.length) { %><div class="bd-msg bd-msg--ok"><span>✓ הכול תקין</span></div><% } %>
  <div class="bd-stack"><% alerts.forEach(([lvl, text]) => { %><div class="bd-msg <%= alertCls[lvl] %>"><span><%= lvl === 'bad' ? '⛔' : lvl === 'warn' ? '⚠️' : 'ℹ️' %> <%= text %></span></div><% }) %></div>
</details>

<details class="bd-fold bd-fold--plain bd-mb" open data-fold>
<summary class="bd-section-title">נתונים</summary>
<div class="bd-stats">
  <div class="bd-stat bd-stat--today"><span class="bd-stat__label">ימי הולדת היום</span><span class="bd-stat__value bd-num"><%= bdays.today %></span>
    <span class="bd-stat__hint">השבוע <span class="bd-num"><%= bdays.week %></span> · ב<%= bdays.monthName %> <span class="bd-num"><%= bdays.month %></span></span></div>
  <div class="bd-stat"><span class="bd-stat__label">ב-30 הימים הקרובים</span><span class="bd-stat__value bd-num"><%= bdays.next30 %></span><span class="bd-stat__hint">ימי הולדת</span></div>
  <div class="bd-stat"><span class="bd-stat__label">כיסוי "יצרתי קשר"</span><span class="bd-stat__value bd-num"><%= pct === null ? '—' : pct + '%' %></span>
    <span class="bd-stat__hint"><span class="bd-num"><%= bdays.covered30 %></span> מתוך <span class="bd-num"><%= bdays.past30 %></span> ימי הולדת ב-30 יום</span></div>
  <div class="bd-stat"><span class="bd-stat__label">כניסות ב-30 יום</span><span class="bd-stat__value bd-num"><%= activity.logins30 %></span>
    <span class="bd-stat__hint">אחרונה: <span class="bd-num" dir="ltr"><%= ago(activity.last_login) %></span></span></div>
  <div class="bd-stat"><span class="bd-stat__label">מקורבים</span><span class="bd-stat__value bd-num"><%= counts.contacts %></span>
    <span class="bd-stat__hint"><span class="bd-num"><%= counts.via_links %></span> דרך קישור · <span class="bd-num"><%= counts.new30 %></span> חדשים ב-30 יום</span></div>
  <div class="bd-stat"><span class="bd-stat__label">בני משפחה</span><span class="bd-stat__value bd-num"><%= counts.family %></span></div>
  <div class="bd-stat"><span class="bd-stat__label">"יצרתי קשר" (סה״כ)</span><span class="bd-stat__value bd-num"><%= counts.contacted %></span>
    <span class="bd-stat__hint"><span class="bd-num"><%= counts.contacted30 %></span> ב-30 יום</span></div>
  <div class="bd-stat"><span class="bd-stat__label">רשומות (מכסה)</span><span class="bd-stat__value bd-num" <%- records.near ? 'style="color:var(--bd-bad)"' : '' %>><%= records.used %></span>
    <span class="bd-stat__hint">מתוך <span class="bd-num"><%= records.quota %></span> · נותרו <span class="bd-num"><%= records.left %></span></span></div>
  <div class="bd-stat"><span class="bd-stat__label">יתרת SMS לתזכורות</span><span class="bd-stat__value bd-num" <%- quota.low ? 'style="color:var(--bd-bad)"' : '' %>><%= quota.left %></span>
    <span class="bd-stat__hint">מתוך <span class="bd-num"><%= quota.quota %></span></span></div>
</div>
</details>

<div class="bd-grid2 bd-mb">
  <details class="bd-card bd-fold" open data-fold><summary class="bd-section-title">פעילות השליח לפי שבוע</summary>
    <%- include('partials/bars', { cols: weeks.map(w => ({ label: w.label, segs: [w.n] })), colors: ['bd-bars__c1'], legend: ['פעולות'], aria: 'פעולות השליח ב-12 השבועות האחרונים' }) %>
  </details>
  <details class="bd-card bd-fold" open data-fold><summary class="bd-section-title">מקורבים חדשים לפי חודש</summary>
    <%- include('partials/bars', { cols: months.map(m => ({ label: m.label, segs: [m.links, m.manual] })), colors: ['bd-bars__c1', 'bd-bars__c2'], legend: ['דרך קישור רישום', 'הוספה ידנית'], aria: 'מקורבים חדשים בחצי השנה האחרונה' }) %>
  </details>
  <details class="bd-card bd-fold" open data-fold><summary class="bd-section-title">יחידות SMS לפי חודש</summary>
    <%- include('partials/bars', { cols: smsMonths.map(m => ({ label: m.label, segs: [m.reminders, m.system] })), colors: ['bd-bars__c1', 'bd-bars__c2'], legend: ['תזכורות (מהמכסה)', 'הודעות מערכת'], aria: 'יחידות SMS בחצי השנה האחרונה' }) %>
  </details>
</div>

<div class="bd-grid2 bd-mb">
  <details class="bd-card bd-fold" open data-fold><summary class="bd-section-title">פעילות</summary>
    <div class="bd-facts">
      <div class="bd-fact"><b>פעולה אחרונה</b><span class="bd-num" dir="ltr"><%= ago(activity.last_action) %></span></div>
      <div class="bd-fact"><b>פעולות ב-30 יום</b><span class="bd-num"><%= activity.actions30 %></span></div>
      <div class="bd-fact"><b>כניסות שנכשלו (30 יום)</b><span class="bd-num <%= activity.failed30 ? 'bd-err' : '' %>"><%= activity.failed30 %></span></div>
      <div class="bd-fact"><b>תקלות מערכת (30 יום)</b><span class="bd-num <%= activity.sys_problems30 ? 'bd-err' : '' %>"><%= activity.sys_problems30 %></span></div>
      <div class="bd-fact"><b>קישורי רישום</b><span><span class="bd-num"><%= counts.links_active %></span> פעילים מתוך <span class="bd-num"><%= counts.links %></span></span></div>
      <div class="bd-fact"><b>סיווגים</b><span class="bd-num"><%= counts.categories %></span></div>
    </div>
  </details>
  <details class="bd-card bd-fold" open data-fold><summary class="bd-section-title">SMS</summary>
    <div class="bd-facts">
      <div class="bd-fact"><b>תזכורות</b><span><%= [s.sms_weekly && 'שבועי', s.sms_daily && 'יומי'].filter(Boolean).join(' + ') || 'כבוי' %></span></div>
      <div class="bd-fact"><b>מכסה לתזכורות</b><span>הוקצו <span class="bd-num"><%= quota.quota %></span> · נוצלו <span class="bd-num"><%= quota.used %></span> · יתרה <span class="bd-num <%= quota.low ? 'bd-err' : '' %>"><%= quota.left %></span></span></div>
    </div>
    <p class="bd-label bd-mt">ב-30 הימים האחרונים</p>
    <% if (!sms.length) { %><p class="bd-help">לא נשלחו הודעות.</p><% } %>
    <ul class="bd-items">
      <% sms.forEach(k => { %><li class="bd-item"><div class="bd-item__main"><%= kindName[k.kind] || k.kind %></div><span class="bd-small"><span class="bd-num"><%= k.n %></span> הודעות · <span class="bd-num"><%= k.units %></span> יחידות</span></li><% }) %>
    </ul>
    <% if (s.sms_last_error) { %><p class="bd-err bd-mt">שגיאה אחרונה: <%= s.sms_last_error %></p><% } %>
  </details>
  <details class="bd-card bd-danger bd-fold" id="danger" open data-fold><summary class="bd-section-title">סגירת חשבון</summary>
    <p class="bd-help bd-mb">מוחק לצמיתות את השליח ואת כל המקורבים, בני המשפחה, הקישורים והיסטוריית הקשר שלו. כדאי שהשליח ייצא קודם את הרשימה (הגדרות ← ייצוא).</p>
    <form method="post" action="/admin/shluchim/<%= s.id %>/delete" class="bd-inline" data-confirm="למחוק לצמיתות את החשבון של <%= s.name %> וכל המידע שבו?

⚠️ המחיקה בלתי הפיכה — לא ניתן לשחזר.">
      <input class="bd-input" name="confirm" placeholder='הקלידו "מחיקה"' aria-label="אישור מחיקה" style="flex:0 0 140px">
      <button class="bd-btn bd-btn--sm bd-btn--danger">מחיקת החשבון</button>
    </form>
  </details>
</div>

  <details class="bd-card bd-fold" id="log" open data-fold><summary class="bd-section-title">היסטוריית פעולות</summary>
    <form method="get" class="bd-mb">
      <select class="bd-input" name="o" aria-label="סינון" data-autosubmit style="max-width:240px">
        <option value="">כל הפעולות</option>
        <option value="problems" <%= problems ? 'selected' : '' %>>רק תקלות וכישלונות</option>
      </select>
    </form>
    <%- include('partials/log_table', { rows, more, page, showShliach: false, OUTCOMES, ACTORS, fmtTime,
      pageUrl: (n) => '?' + new URLSearchParams({ ...(problems ? { o: 'problems' } : {}), page: n }) }) %>
  </details>
<%- include('partials/foot') %>
