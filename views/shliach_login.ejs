<%- include('partials/head', { title: 'כניסה — ' + shliach.name }) %>
<div class="narrow card center">
  <div class="hero-icon">🔒</div>
  <h1><%= shliach.name %></h1>
  <p class="muted">הזינו את קוד הכניסה</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="<%= base %>/login">
    <input name="code" type="password" class="code-input" required autofocus autocomplete="current-password" aria-label="קוד כניסה">
    <button class="btn wide">כניסה</button>
  </form>
</div>
<%- include('partials/foot') %>
