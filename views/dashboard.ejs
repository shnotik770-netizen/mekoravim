<%- include('partials/head', { title: 'דשבורד', nav: true, active: 'dashboard' }) %>
<%
  const fmt = (d) => d.getDate() + '.' + (d.getMonth() + 1) + (d.getFullYear() !== today.getFullYear() ? '.' + d.getFullYear() : '');
  const span = (a, b) => +a === +b ? fmt(a) : fmt(a) + '–' + fmt(b);
  const monthWord = monthRange.name.split(' ')[0];
  const days = Math.round((range.end - range.start) / 864e5) + 1;
  // כותרת לכל תצוגה: [כותרת, תאריך עברי, תאריך לועזי, תוספת]
  const titles = {
    today: ['היום', hebToday, fmt(today), 'יום ' + DAY_NAMES[today.getDay()]],
    week: ['השבוע', weekInfo.heb, span(weekRange.start, weekRange.end), weekInfo.parsha],
    month: ['חודש ' + monthWord, monthRange.name, span(monthRange.start, monthRange.end)],
    range: [range.preset ? '30 הימים הקרובים' : 'טווח נבחר', hebRangeStr(range.start, range.end), span(range.start, range.end), days + ' ימים'],
    missed: ['עברו בלי ברכה', hebRangeStr(missed.start, missed.end), span(missed.start, missed.end), lists.missed.length ? (lists.missed.length === 1 ? 'ממתין אחד' : lists.missed.length + ' ממתינים') : ''],
  };
  const back = qs({});
  const segs = [['today', 'היום'], ['week', 'השבוע'], ['month', 'חודש ' + monthWord]];
%>
<% if (sms.on && sms.low) { %>
<div class="bd-msg bd-msg--warn bd-sms-alert" role="alert"><span>⚠️ <b>שימו לב:</b> <% if (sms.empty) { %>יתרת ה-SMS לתזכורות ימי הולדת נגמרה — התזכורות האוטומטיות הופסקו.<% } else { %>יתרת ה-SMS לתזכורות ימי הולדת עומדת להסתיים (נותרו עוד <bdi class="bd-num"><%= sms.left %></bdi> יחידות).<% } %> לחידוש המכסה פנו למנהל.</span></div>
<% } %>
<section class="bd-head">
  <h1 class="bd-title">שלום, <%= displayName(shliach) %></h1>
  <p class="bd-sub">היום יום <%= DAY_NAMES[today.getDay()] %>, <%= hebToday %> · <span class="bd-num"><%= fmtGreg(today) %></span></p>

</section>

<div class="bd-stats">
  <a class="bd-stat bd-stat--today" href="<%= qs({ view: 'today' }) %>" aria-pressed="<%= view === 'today' %>">
    <span class="bd-stat__label">היום</span><span class="bd-stat__value bd-num"><%= lists.today.length %></span>
  </a>
  <a class="bd-stat" href="<%= qs({ view: 'week' }) %>" aria-pressed="<%= view === 'week' %>">
    <span class="bd-stat__label">השבוע</span><span class="bd-stat__value bd-num"><%= lists.week.length %></span>
    <span class="bd-stat__hint bd-num"><%= titles.week[2] %></span>
    <span class="bd-stat__hint"><%= weekInfo.parsha %></span>
  </a>
  <a class="bd-stat" href="<%= qs({ view: 'month' }) %>" aria-pressed="<%= view === 'month' %>">
    <span class="bd-stat__label">בחודש <%= monthWord %></span><span class="bd-stat__value bd-num"><%= lists.month.length %></span>
    <span class="bd-stat__hint bd-num"><%= titles.month[2] %></span>
  </a>
  <a class="bd-stat" href="<%= base %>/contacts">
    <span class="bd-stat__label">מקורבים</span><span class="bd-stat__value bd-num"><%= total %></span>
    <span class="bd-stat__hint"><%= familyTotal ? '+ ' + familyTotal + ' בני משפחה' : '' %></span>
  </a>
</div>

<% if (total) { %><p class="bd-takeaway bd-takeaway--below">
    <% if (lists.today.length) { %>🎂 היום יום ההולדת של <b><%= lists.today.map(e => e.name).join(', ') %></b>
    <% } else { %>אין ימי הולדת היום<% if (next) { %> · הבא: <b><%= next.name %></b> ב<%= next.label %><% } %><% } %>
    <% if (overdue.length) { %> · <span style="color:var(--bd-bad)"><%= overdue.length %> ממתינים לברכה</span><% } %>
  </p><% } %>
<% if (total) { %><a class="bd-missed-btn" href="<%= qs({ view: 'missed' }) %>" aria-pressed="<%= view === 'missed' %>">⏳ ימי הולדת שעברו בלי ברכה<% if (overdue.length) { %> <span class="bd-missed-btn__n bd-num"><%= overdue.length %></span><% } %><span class="bd-missed-btn__hint">שבועיים אחרונים · אפשר לבחור טווח</span></a><% } %>
<% if (!total) { %><p class="bd-empty-start">עדיין אין מקורבים — <a href="<%= base %>/links">צרו קישור רישום</a>, <a href="<%= base %>/contacts/new">הוסיפו מקורב</a> או <a href="<%= base %>/contacts/import">ייבאו רשימה מאקסל</a>.</p><% } %>

<a class="bd-sms-usage <%= sms.on && sms.low ? 'bd-sms-usage--low' : '' %>" href="<%= base %>/settings#sms" aria-label="יחידות SMS לתזכורות ימי הולדת">
  <span class="bd-sms-usage__title">📱 SMS לתזכורות<% if (!sms.on) { %> <span class="bd-muted">(כבוי)</span><% } else { %> <span class="bd-muted">(<%= [sms.weekly && 'שבועי', sms.daily && 'יומי'].filter(Boolean).join(' + ') %>)</span><% } %></span>
  <span class="bd-sms-usage__nums">
    <span>הוקצו <b class="bd-num"><%= sms.quota %></b></span>
    <span>נוצלו <b class="bd-num"><%= sms.used %></b></span>
    <span>יתרה <b class="bd-num"><%= sms.left %></b></span>
  </span>
  <span class="bd-sms-usage__bar" aria-hidden="true"><span style="width:<%= sms.quota ? Math.min(100, Math.round(sms.used / sms.quota * 100)) : 100 %>%"></span></span>
</a>

<div class="bd-tools">
  <form class="bd-search" method="get" action="<%= base %>/contacts" role="search">
    <span class="bd-visually-hidden">חיפוש מקורב</span>
    <%- include('partials/icons', { name: 'search' }) %>
    <input class="bd-input" type="search" name="q" placeholder="חיפוש מקורב לפי שם או טלפון…" autocomplete="off" aria-label="חיפוש מקורב">
  </form>
  <% if (categories.length) { %>
  <div class="bd-chips" role="group" aria-label="סינון לפי סיווג">
    <a class="bd-chip" href="<%= qs({ cat: '' }) %>" aria-pressed="<%= !cat %>">הכל</a>
    <% categories.forEach(c => { %><a class="bd-chip" href="<%= qs({ cat: cat === c.id ? '' : c.id }) %>" aria-pressed="<%= cat === c.id %>" style="--tag:<%= c.color %>"><span class="bd-dot"></span><%= c.name %></a><% }) %>
  </div>
  <% } %>
</div>

<div class="bd-layout bd-layout--split">
  <section class="bd-card" aria-labelledby="bd-list-title">
    <div class="bd-card__head">
      <div class="bd-titlerow">
        <h2 class="bd-card__title" id="bd-list-title"><%= titles[view][0] %></h2>
        <p class="bd-dates"><span class="bd-dates__heb"><%= titles[view][1] %></span><span class="bd-dates__greg"><bdi class="bd-num"><%= titles[view][2] %></bdi><% if (titles[view][3]) { %> · <%= titles[view][3] %><% } %></span></p>
      </div>
      <% if (view === 'missed') { %>
      <a class="bd-btn bd-btn--ghost bd-btn--sm bd-back-normal" href="<%= qs({ view: 'week' }) %>">→ חזרה לתצוגה הרגילה</a>
      <% } else { %>
      <div class="bd-seg" role="tablist" aria-label="טווח">
        <% segs.forEach(([k, l]) => { %><a role="tab" href="<%= qs({ view: k }) %>" aria-selected="<%= view === k %>"><%= l %></a><% }) %>
        <a role="tab" href="<%= qs({ view: 'range' }) %>" aria-selected="<%= view === 'range' %>" data-range-open="range" aria-haspopup="dialog">📅 טווח</a>
      </div>
      <% } %>
      <% if (view === 'missed') { %>
      <div class="bd-missed-chips" role="group" aria-label="כמה זמן אחורה">
        <% MISSED_DAYS.forEach(d => { %><a class="bd-chip" href="<%= qs({ view: 'missed', days: d }) %>" aria-pressed="<%= missed.days === d %>"><%= { 7: 'שבוע', 14: 'שבועיים', 30: 'חודש', 90: '3 חודשים', 180: 'חצי שנה' }[d] %></a><% }) %>
        <a class="bd-chip" href="<%= qs({ view: 'missed', days: 14 }) %>" data-range-open="missed" aria-pressed="<%= !missed.days %>" aria-haspopup="dialog">📅 טווח אחר</a>
      </div>
      <% } %>
    </div>
    <ul class="bd-list">
      <% if (!list.length) { %>
        <li class="bd-empty"><div class="bd-empty__icon" aria-hidden="true">🕯️</div><%= view === 'missed' ? '👏 כל הכבוד — לא נשאר אף אחד בלי ברכה בטווח הזה' : cat ? 'אין ימי הולדת של "' + (catById.get(cat)?.name || '') + '" בטווח הזה' : 'אין ימי הולדת בטווח הזה' %></li>
      <% } %>
      <% list.forEach(e => { %><%- include('partials/event_row', { e, back }) %><% }) %>
    </ul>
  </section>

  <aside>
    <% if (total) { %>
      <% if (overdue.length) { %>
      <div class="bd-alert" role="region" aria-label="ממתינים לברכה">
        <div class="bd-alert__title"><%- include('partials/icons', { name: 'bell' }) %>ממתינים לברכה</div>
        <p class="bd-help" style="margin-bottom:8px">ימי הולדת מהשבועיים האחרונים שעוד לא סומנו "נוצר קשר"</p>
        <ul class="bd-mini">
          <% overdue.forEach(e => { const d = String(e.contact.phone || '').replace(/\D/g, ''); %>
          <li>
            <span class="bd-mini__name"><a href="<%= base %>/contacts/<%= e.contact.id %>"><%= e.name %></a><div class="bd-mini__date"><%= e.label %><%= e.note ? ' (' + e.actualLabel + ')' : '' %> · <span class="bd-num"><%= e.date.getDate() %>.<%= e.date.getMonth() + 1 %></span></div></span>
            <% if (d) { %><a class="bd-icon-btn bd-icon-btn--wa" href="https://wa.me/972<%= d.replace(/^0/, '') %>" target="_blank" rel="noopener" aria-label="וואטסאפ ל<%= e.name %>"><%- include('partials/icons', { name: 'chat' }) %></a><% } %>
            <form method="post" action="<%= base %>/contacts/<%= e.contact.id %>/log" data-quicklog data-name="<%= e.name %>">
              <input type="hidden" name="back" value="<%= back %>">
              <% if (e.member) { %><input type="hidden" name="family_member_id" value="<%= e.member.id %>"><% } %>
              <button class="bd-btn bd-btn--ghost bd-btn--sm">יצרתי קשר</button>
            </form>
          </li>
          <% }) %>
        </ul>
        <a class="bd-alert__more" href="<%= qs({ view: 'missed' }) %>">הצגה ברשימה ובחירת טווח ←</a>
      </div>
      <% } else { %>
      <div class="bd-card bd-side-card"><div class="bd-ok-note"><%- include('partials/icons', { name: 'check' }) %>כל הברכות מהשבועיים האחרונים נשלחו</div></div>
      <% } %>
      <% if (upcoming.length) { %>
      <div class="bd-card bd-side-card" style="margin-top:16px">
        <div class="bd-card__head" style="margin-bottom:4px"><h3 class="bd-label">בשבוע הבא ואחריו</h3></div>
        <ul class="bd-mini">
          <% upcoming.forEach(e => { %>
          <li>
            <span class="bd-mini__name"><a href="<%= base %>/contacts/<%= e.contact.id %>"><%= e.name %></a><div class="bd-mini__date">יום <%= DAY_NAMES[e.date.getDay()] %> · <%= e.label %><%= e.note ? ' (' + e.actualLabel + ')' : '' %> · <span class="bd-num"><%= e.date.getDate() %>.<%= e.date.getMonth() + 1 %></span></div></span>
            <%- include('partials/cat_chip', { cat: catById.get(e.contact.category_id) }) %>
          </li>
          <% }) %>
        </ul>
      </div>
      <% } %>
    <% } %>
  </aside>
</div>
<dialog class="bd-range" id="bd-range" aria-labelledby="bd-range-title">
  <form method="get" class="bd-range__form" data-range-form data-today="<%= toISO(today) %>" data-max="<%= maxRange %>">
    <input type="hidden" name="view" value="<%= view === 'missed' ? 'missed' : 'range' %>">
    <% if (cat) { %><input type="hidden" name="cat" value="<%= cat %>"><% } %>
    <div class="bd-range__head">
      <h2 class="bd-range__title" id="bd-range-title">בחירת טווח תאריכים</h2>
      <button type="button" class="bd-range__x" data-range-close aria-label="סגירה">✕</button>
    </div>
    <div class="bd-range__presets" role="group" aria-label="טווחים מוכנים">
      <button type="button" data-preset="7">7 ימים</button>
      <button type="button" data-preset="30">30 ימים</button>
      <button type="button" data-preset="90">3 חודשים</button>
      <button type="button" data-preset="180" data-past>חצי שנה</button>
      <button type="button" data-preset="next-week" data-future>שבוע הבא</button>
    </div>
    <div class="bd-cal" data-cal></div>
    <div class="bd-range__fields">
      <label><span class="bd-help">מתאריך</span><input class="bd-input" type="date" name="from" value="<%= toISO(view === 'missed' ? missed.start : range.start) %>" required></label>
      <label><span class="bd-help">עד תאריך</span><input class="bd-input" type="date" name="to" value="<%= toISO(view === 'missed' ? missed.end : range.end) %>" required></label>
    </div>
    <p class="bd-range__sum" data-range-sum aria-live="polite"></p>
    <button class="bd-btn bd-btn--primary bd-btn--block">הצגת ימי ההולדת בטווח</button>
  </form>
</dialog>
<dialog class="bd-qlog" id="bd-qlog" aria-labelledby="bd-qlog-title">
  <form class="bd-qlog__form" data-qlog-form>
    <div class="bd-qlog__ok" aria-hidden="true">✓</div>
    <h2 class="bd-qlog__title" id="bd-qlog-title">נשמר בהצלחה</h2>
    <p class="bd-qlog__sub" data-qlog-sub></p>
    <p class="bd-help">רוצים לרשום איך נוצר הקשר? <span class="opt">(רשות)</span></p>
    <div class="bd-qlog__methods" role="radiogroup" aria-label="איך נוצר הקשר">
      <% ['וואטסאפ', 'שיחת טלפון', 'SMS', 'פגישה', 'אחר'].forEach(m => { %><label><input type="radio" name="method" value="<%= m %>"><span><%= m %></span></label><% }) %>
    </div>
    <textarea class="bd-input" name="note" rows="2" maxlength="450" placeholder="הערה — למשל: שמח מאוד, ביקש לבוא לשיעור"></textarea>
    <div class="bd-qlog__btns">
      <button class="bd-btn bd-btn--primary" data-qlog-save>שמירת הערה</button>
      <button type="button" class="bd-btn bd-btn--ghost" data-qlog-close>סגירה</button>
    </div>
  </form>
</dialog>
<dialog class="bd-qlog" id="bd-waask" aria-labelledby="bd-waask-title">
  <div class="bd-qlog__form">
    <div class="bd-qlog__ok bd-qlog__ok--wa" aria-hidden="true">💬</div>
    <h2 class="bd-qlog__title" id="bd-waask-title">שליחת ברכה בוואטסאפ</h2>
    <p class="bd-qlog__sub" data-wa-sub></p>
    <div class="bd-qlog__col">
      <button type="button" class="bd-btn bd-btn--primary" data-wa-mark>שליחה וסימון "נוצר קשר"</button>
      <button type="button" class="bd-btn bd-btn--ghost" data-wa-only>רק שליחה</button>
      <button type="button" class="bd-link-btn" data-wa-cancel>ביטול</button>
    </div>
  </div>
</dialog>
<%- include('partials/foot') %>
