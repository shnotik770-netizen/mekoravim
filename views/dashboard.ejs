<%- include('partials/head', { title: 'דשבורד', nav: true }) %>
<%
  const todays = week.filter(e => e.date.getTime() === today.getTime());
  const open = (list) => list.filter(e => !e.contacted && e.date <= today).length;
%>
<div class="pagehead">
  <div>
    <h1>שלום, <%= shliach.name %></h1>
    <div class="muted">היום <%= hebToday %> · <%= fmtGreg(today) %></div>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="num"><%= todays.length %></div><div>היום</div></div>
  <div class="stat"><div class="num"><%= week.length %></div><div>השבוע</div></div>
  <div class="stat"><div class="num"><%= month.length %></div><div>בחודש <%= monthRange.name.split(' ')[0] %></div></div>
  <a class="stat" href="<%= base %>/contacts"><div class="num"><%= total %></div><div>מקורבים</div></a>
</div>

<form class="search" method="get" action="<%= base %>/contacts">
  <input name="q" placeholder="🔍 חיפוש מקורב לפי שם או טלפון…">
</form>

<% if (categories.length) { %>
<div class="filters">
  <a class="fchip <%= !cat ? 'on' : '' %>" href="<%= base %>">הכל</a>
  <% categories.forEach(c => { %><a class="fchip <%= cat === c.id ? 'on' : '' %>" style="--c: <%= c.color %>" href="<%= base %>?cat=<%= c.id %>"><%= c.name %></a><% }) %>
</div>
<% } %>

<% if (!total && !cat) { %>
<div class="card highlight">
  <h3>👋 מתחילים</h3>
  <p>הוסיפו מקורב ידנית, או צרו <a href="<%= base %>/links">קישור רישום</a> ושלחו אותו למקורבים — כל מי שנרשם יופיע כאן אוטומטית.</p>
  <div class="actions"><a class="btn" href="<%= base %>/contacts/new">+ הוספת מקורב</a><a class="btn ghost" href="<%= base %>/links">יצירת קישור רישום</a></div>
</div>
<% } %>

<section class="card">
  <h2>השבוע <small class="muted"><%= fmtGreg(weekRange.start).slice(0,-5) %>–<%= fmtGreg(weekRange.end).slice(0,-5) %></small>
    <% if (open(week)) { %><span class="tag warn"><%= open(week) %> ממתינים לברכה</span><% } %></h2>
  <% if (!week.length) { %><p class="muted">אין ימי הולדת השבוע.</p><% } %>
  <% week.forEach(e => { %><%- include('partials/event_row', { e }) %><% }) %>
</section>

<section class="card">
  <h2>חודש <%= monthRange.name %></h2>
  <% if (!month.length) { %><p class="muted">אין ימי הולדת החודש.</p><% } %>
  <% month.forEach(e => { %><%- include('partials/event_row', { e }) %><% }) %>
</section>

<section class="card">
  <h2>30 הימים הקרובים</h2>
  <% if (!upcoming.length) { %><p class="muted">אין ימי הולדת קרובים.</p><% } %>
  <% upcoming.forEach(e => { %><%- include('partials/event_row', { e }) %><% }) %>
</section>
<%- include('partials/foot') %>
