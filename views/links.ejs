<%- include('partials/head', { title: 'קישורי רישום', nav: true, active: 'links' }) %>
<div class="bd-head">
  <h1 class="bd-title">קישורי רישום</h1>
  <p class="bd-sub" style="font-size:var(--bd-fs-md);max-width:680px">צרו כמה קישורים שתרצו — לכל שיעור, קבוצה או אירוע — ושלחו אותם למקורבים. מי שממלא קישור נכנס לרשימה שלכם <b>ומסווג אוטומטית</b> בסיווג שבחרתם לאותו קישור.</p>
</div>
<div class="bd-layout bd-layout--split">
<section class="bd-card">
  <h2 class="bd-section-title">הקישורים שלי</h2>
  <% if (!links.length) { %><div class="bd-empty"><div class="bd-empty__icon" aria-hidden="true">🔗</div>עדיין לא נוצרו קישורים</div><% } %>
  <ul class="bd-items">
  <% links.forEach(l => { const url = site + '/r/' + l.token; %>
    <li class="bd-item <%= l.active ? '' : 'bd-item--off' %>">
      <div class="bd-item__main">
        <div class="bd-item__title"><%= l.name %> <%- include('partials/cat_chip', { cat: catById.get(l.category_id) }) %>
          <span class="bd-status bd-status--accent"><%= l.n %> נרשמו</span><% if (!l.active) { %><span class="bd-status bd-status--bad">כבוי</span><% } %></div>
        <div class="bd-item__sub"><code class="bd-code copy"><%= url %></code></div>
        <details class="bd-mt">
          <summary class="bd-link-btn bd-link-btn--accent">✏️ עריכה</summary>
          <form method="post" action="<%= base %>/links/<%= l.id %>" class="bd-inline">
            <input class="bd-input" name="name" value="<%= l.name %>" maxlength="80" required aria-label="שם הקישור">
            <select class="bd-input" name="category_id" aria-label="סיווג">
              <option value="">ללא סיווג</option>
              <% categories.forEach(c => { %><option value="<%= c.id %>" <%= l.category_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
            </select>
            <button class="bd-btn bd-btn--primary bd-btn--sm">שמירה</button>
          </form>
          <p class="bd-help">שינוי הסיווג חל על נרשמים חדשים בלבד.</p>
        </details>
      </div>
      <div class="bd-actions">
        <% if (l.active) { %>
          <button type="button" class="bd-btn bd-btn--soft bd-btn--sm bd-copy-btn" data-copy="<%= url %>"><%- include('partials/icons', { name: 'copy' }) %><span>העתקת קישור</span></button>
          <a class="bd-icon-btn bd-icon-btn--wa" target="_blank" rel="noopener" href="https://wa.me/?text=<%= encodeURIComponent('נשמח לדעת מתי יום ההולדת שלך 🎂 ' + url) %>" aria-label="שליחה בוואטסאפ"><%- include('partials/icons', { name: 'chat' }) %></a>
          <a class="bd-btn bd-btn--ghost bd-btn--sm" target="_blank" rel="noopener" href="<%= url %>">תצוגה</a>
        <% } %>
        <form method="post" action="<%= base %>/links/<%= l.id %>/toggle"><button class="bd-btn bd-btn--ghost bd-btn--sm"><%= l.active ? 'כיבוי' : 'הפעלה' %></button></form>
      </div>
    </li>
  <% }) %>
  </ul>
</section>
<aside class="bd-card">
  <h2 class="bd-section-title">קישור חדש</h2>
  <form method="post">
    <div class="bd-field"><label class="bd-label" for="ln-name">שם הקישור</label><input class="bd-input" id="ln-name" name="name" placeholder="למשל: שיעור שבועי" maxlength="80"></div>
    <div class="bd-field"><label class="bd-label" for="ln-cat">מי שנרשם דרכו יסווג כ:</label>
      <select class="bd-input" id="ln-cat" name="category_id">
        <% categories.forEach((c, i) => { %><option value="<%= c.id %>" <%= i === 0 ? 'selected' : '' %>><%= c.name %></option><% }) %>
        <option value="">ללא סיווג</option>
      </select></div>
    <button class="bd-btn bd-btn--primary bd-btn--block" style="min-height:var(--bd-tap);font-size:var(--bd-fs-md)">יצירת קישור</button>
    <p class="bd-help bd-mt"><a href="<%= base %>/settings">ניהול סיווגים</a></p>
  </form>
</aside>
</div>
<%- include('partials/foot') %>
